                            Editar
                        </a>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-3" style="padding-bottom: 15px;">
                        <a asp-action="Visualizar" asp-controller="ParametrizacaoBeneficiario" asp-route-id="@Model.Beneficiario.Beneficiario.Id" class="default-btn btn d-flex justify-content-center align-items-center">
                            Visualizar
                        </a>
                    </div>
                }
                else
                {
                    <div class="col-sm-12 col-md-12 col-lg-6 alert alert-warning text-center" role="alert" style="color: #b59900; border-radius: 15px; padding-bottom: 15px;">
                        <h6>Atenção!</h6>
                        <h6>Cadastre os parâmetros do financeiro do beneficiário para uma melhor experência em seu Multi-Cálculo.</h6>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-3" style="padding-bottom: 15px;">
                        <a asp-action="Cadastrar" asp-controller="ParametrizacaoBeneficiario" class="default-btn btn d-flex justify-content-center align-items-center">
                            Cadastrar
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
    <br /> <br />
