@model MCR.API.Models.ViewModels.ParametrizacaoModel
@{
    ViewData["Title"] = "Parametrizações";
}
<div class="form-box">
    <h4 class="form-title form-box-title justify-content-center align-items-center">Parametrizações</h4>
    <br /><br />
    <div class="row">
        <div class="col-md-3">
            <a asp-action="Index" asp-controller="Home" class="default-btn btn d-flex justify-content-center align-items-center">
                Voltar
            </a>
        </div>
    </div>
    <br /><br />
    <h6>Seguradoras</h6>
    <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)">
        <div class="card-body" style="color: var(--color-primary)">
            <div class="row">
                <div class="col-sm-12 col-md-12 col-lg-3" style="padding-bottom: 15px;">
                    <svg fill="#2A5736" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="64px" height="64px" viewBox="0 0 256 190" enable-background="new 0 0 256 190" xml:space="preserve"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M48.12,27.903C48.12,13.564,59.592,2,74.023,2c14.339,0,25.903,11.564,25.903,25.903 C99.834,42.335,88.27,53.806,74.023,53.806C59.684,53.806,48.12,42.242,48.12,27.903z M191,139h-47V97c0-20.461-17.881-37-38-37H43 C20.912,60,1.99,79.14,2,98v77c-0.026,8.533,6.001,12.989,12,13c6.014,0.011,12-4.445,12-13v-75h8v88h78v-88h8l0.081,50.37 c-0.053,8.729,5.342,12.446,10.919,12.63h60C207.363,163,207.363,139,191,139z M254,17.792v63.167c0,0-0.563,29.22-47.375,47.375 c-46.812-18.155-47.375-47.375-47.375-47.375V17.792L206.61,2.01V2l0.015,0.005L206.64,2v0.01L254,17.792z M235.854,48.753 l-8.365-8.389l-26.994,26.915l-14.721-14.726l-8.379,8.379l23.09,23.085L235.854,48.753z"></path> </g></svg>
                </div>
                @if (Model.Seguradora.Seguradora.Sucesso)
                {
                    <div class="col-sm-12 col-md-12 col-lg-3" style="padding-bottom: 15px;">
                        <a asp-action="Editar" asp-controller="ParametrizacaoSeguradora" asp-route-id="@Model.Seguradora.Seguradora.Id" class="default-btn btn d-flex justify-content-center align-items-center">
                            Editar
                        </a>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-3" style="padding-bottom: 15px;">
                        <a asp-action="Visualizar" asp-controller="ParametrizacaoSeguradora" asp-route-id="@Model.Seguradora.Seguradora.Id" class="default-btn btn d-flex justify-content-center align-items-center">
                            Visualizar
                        </a>
                    </div>
                }
                else
                {
                    <div class="col-sm-12 col-md-12 col-lg-6 alert alert-warning text-center" role="alert" style="color: #b59900; border-radius: 15px; padding-bottom: 15px;">
                        <h6>Atenção!</h6>
                        <h6>Cadastre os parâmetros de suas seguradoras para uma melhor experência em seu Multi-Cálculo.</h6>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-3" style="padding-bottom: 15px;">
                        <a asp-action="Cadastrar" asp-controller="ParametrizacaoSeguradora" class="default-btn btn d-flex justify-content-center align-items-center">
                            Cadastrar
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
    <br /> <br />
    <h6>Riscos</h6>
    <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)">
        <div class="card-body" style="color: var(--color-primary)">
            <div class="row">
                <div class="col-sm-12 col-md-12 col-lg-3" style="padding-bottom: 15px;">
                    <svg fill="#2A5736" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="64px" height="64px" viewBox="0 0 256 190" enable-background="new 0 0 256 190" xml:space="preserve"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M48.12,27.903C48.12,13.564,59.592,2,74.023,2c14.339,0,25.903,11.564,25.903,25.903 C99.834,42.335,88.27,53.806,74.023,53.806C59.684,53.806,48.12,42.242,48.12,27.903z M191,139h-47V97c0-20.461-17.881-37-38-37H43 C20.912,60,1.99,79.14,2,98v77c-0.026,8.533,6.001,12.989,12,13c6.014,0.011,12-4.445,12-13v-75h8v88h78v-88h8l0.081,50.37 c-0.053,8.729,5.342,12.446,10.919,12.63h60C207.363,163,207.363,139,191,139z M157,79.003c0-26.792,21.716-48.508,48.5-48.508 c26.784,0,48.5,21.716,48.5,48.508c0,26.784-21.716,48.5-48.5,48.5C178.716,127.503,157,105.787,157,79.003z M184.475,85.073h15.646 l-11.635,28.222l38.31-39.228h-16.485l16.485-28.222h-18.841L184.475,85.073z"></path> </g></svg>
                </div>
                @if (Model.Risco.Risco.Sucesso)
                {
                    <div class="col-sm-12 col-md-12 col-lg-3" style="padding-bottom: 15px;">
                        <a asp-action="Editar" asp-controller="ParametrizacaoRisco" asp-route-id="@Model.Risco.Risco.Id" class="default-btn btn d-flex justify-content-center align-items-center">
                            Editar
                        </a>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-3" style="padding-bottom: 15px;">
                        <a asp-action="Visualizar" asp-controller="ParametrizacaoRisco" asp-route-id="@Model.Risco.Risco.Id" class="default-btn btn d-flex justify-content-center align-items-center">
                            Visualizar
                        </a>
                    </div>
                }
                else
                {
                    <div class="col-sm-12 col-md-12 col-lg-6 alert alert-warning text-center" role="alert" style="color: #b59900; border-radius: 15px; padding-bottom: 15px;">
                        <h6>Atenção!</h6>
                        <h6>Cadastre os parâmetros de risco para uma melhor experência em seu Multi-Cálculo.</h6>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-3" style="padding-bottom: 15px;">
                        <a asp-action="Cadastrar" asp-controller="ParametrizacaoRisco" class="default-btn btn d-flex justify-content-center align-items-center">
                            Cadastrar
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
    <br /> <br />
