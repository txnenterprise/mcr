@using System.Collections.Generic
@using MCR.API.Shared.Extensions
@model IList<MCR.API.Entities.CotacoesAgricolaEntity>
@{
    ViewData["Title"] = "Cotações Agrícolas";
    var pesquisaCodigoCotacao = ViewBag.PesquisaCodigoCotacao as string;
    var pesquisaSafra = ViewBag.PesquisaSafra as string;
    var pesquisaCultura = ViewBag.PesquisaCultura as string;
    var pesquisaMunicipio = ViewBag.PesquisaMunicipio as string;
    var pesquisaDataCotacao = ViewBag.PesquisaDataCotacao as string;
    var pesquisaCpf = ViewBag.PesquisaCpf as string;
    var paginaAtual = ViewBag.PaginaAtual as int? ?? 1;
    var totalPaginas = ViewBag.TotalPaginas as int? ?? 0;
    var userRole = ViewBag.UserRole as string ?? string.Empty;
}
<div class="form-box">
    <h4 class="form-title form-box-title justify-content-center align-items-center">Cotações Agrícolas</h4>
    <br />
    <div class="row">
        <div class="col-md-2">
            <a asp-action="Cadastrar" asp-controller="CotacaoAgricola" class="btn btn-secondary rounded-pill">
                Nova Cotação
            </a>
        </div>
    </div>
    <br />
    <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)">
        <div class="card-body" style="color: var(--color-primary)">
            <h6>Filtros</h6>
            <br />
            <form asp-action="Index" method="get">
                <div class="row">
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <div class="form-group">
                            <label for="codigoCotacao">Número da Cotação</label>
                            <input type="text" class="form-control"
                                   name="codigoCotacao"
                                   value="@pesquisaCodigoCotacao" />
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <div class="form-group">
                            <label for="safra">Safra</label>
                            <select class="form-select form-dropdownlist" name="safra">
                                <option value="">Todos</option>
                                @if (ViewBag.Safra != null)
                                {
                                    foreach (var safra in ViewBag.Safra)
                                    {
                                        <option value="@safra.Text" selected="@(pesquisaSafra == safra.Text)">@safra.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <div class="form-group">
                            <label for="cultura">Cultura</label>
                            <select class="form-select form-dropdownlist" name="cultura">
                                <option value="">Todos</option>
                                @if (ViewBag.Cultura != null)
                                {
                                    foreach (var cultura in ViewBag.Cultura)
                                    {
                                        <option value="@cultura.Text" selected="@(pesquisaCultura == cultura.Text)">@cultura.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <div class="form-group">
                            <label for="municipio">Município</label>
                            <input type="text" class="form-control"
                                   name="municipio"
                                   value="@pesquisaMunicipio" />
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <div class="form-group">
                            <label for="dataCotacao">Data da Cotação</label>
                            <input type="date" class="form-control"
                                   name="dataCotacao"
                                   value="@pesquisaDataCotacao" />
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <div class="form-group">
                            <label for="cpfCliente">CPF</label>
                            <input type="text" class="form-control"
                                   name="cpfCliente"
                                   value="@pesquisaCpf" />
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <br />
                        <button type="submit" class="btn btn-primary">Filtrar</button>
                        <a asp-action="Index" class="btn btn-secondary">Limpar Filtros</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <br />
    <div style="">
        <table id="tblCotacoes" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Número da Cotação</th>
                    <th>Safra</th>
                    <th>Cultura</th>
                    <th>Município</th>
                    <th>Data da Última Cotação</th>
                    <th>CPF</th>
                    <th>Nome do Cliente</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var item in Model)
                    {
                        var status = item.Status ?? string.Empty;
                        var temAcoes = status != "Cotação encerrada sem sucesso" || userRole == "Administrador" || userRole == "Corretor";
                        <tr>
                            <td>@item.CodigoCotacao</td>
                            <td>@item.Safra?.AnoReferencia</td>
                            <td>@item.Cultura?.Nome</td>
                            <td>@item.Municipio</td>
                            <td>@item.DataCotacao?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>@(item.Cliente?.CPF ?? item.ClienteCPF)</td>
                            <td>@(item.Cliente?.Nome ?? item.ClienteNome ?? "-")</td>
                            <td>@item.Status</td>
                            <td style="width: 150px;">
                                <a asp-action="Gerenciar" asp-route-id="@item.Id" class="btn btn-info btn-sm" title="Gerenciar">
                                    <i class="bi bi-search"></i>
                                </a>
                                @if (temAcoes)
                                {
                                    var showPdf = status != "Cotação encerrada sem sucesso";
                                    var showInsucesso = status != "Cotação encerrada sem sucesso";
                                    var showExcluir = (userRole == "Administrador" || userRole == "Corretor") && status == "Em Andamento";
                                    var showReabrir = status == "Cotação encerrada sem sucesso" && (userRole == "Administrador" || userRole == "Corretor");
                                    var showVerPropostas = status == "Cotação realizada com sucesso" || status == "Cotação em negociação";
                                    var hasAnyAction = showPdf || showInsucesso || showExcluir || showReabrir || showVerPropostas;

                                    @if (hasAnyAction)
                                    {
                                        <div class="dropdown d-inline-block">
                                            <button type="button" class="btn btn-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                Ações
                                            </button>
                                            <div class="dropdown-menu">
                                                @if (showPdf)
                                                {
                                                    <a asp-action="GerarPDF" asp-controller="CotacaoAgricola" asp-route-id="@item.Id" target="_blank" class="dropdown-item">
                                                        <i class="bi bi-file-pdf mr-2"></i> PDF
                                                    </a>
                                                }
                                                @if (showVerPropostas)
                                                {
                                                    <a asp-action="Gerenciar" asp-controller="CotacaoAgricola" asp-route-id="@item.Id" class="dropdown-item">
                                                        <i class="bi bi-file-text mr-2"></i> Ver Propostas
                                                    </a>
                                                }
                                                @if (showExcluir)
                                                {
                                                    <button type="button" class="dropdown-item text-danger" onclick="confirmarExclusao('@item.Id')">
                                                        <i class="bi bi-trash mr-2"></i> Excluir
                                                    </button>
                                                }
                                                @if (showInsucesso)
                                                {
                                                    @if (showPdf || showVerPropostas)
                                                    {
                                                        <div class="dropdown-divider"></div>
                                                    }
                                                    <button type="button" class="dropdown-item text-danger" onclick="confirmarInsucesso('@item.Id')">
                                                        <i class="bi bi-x-circle mr-2"></i> Insucesso
                                                    </button>
                                                }
                                                @if (showReabrir)
                                                {
                                                    @if (showInsucesso)
                                                    {
                                                        <div class="dropdown-divider"></div>
                                                    }
                                                    <button type="button" class="dropdown-item text-success" onclick="reabrirCotacao('@item.Id')">
                                                        <i class="bi bi-arrow-counterclockwise mr-2"></i> Reabrir
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div style="overflow-x:auto;">
        <nav aria-label="Page navigation">
            <ul class="pagination">
                @if (paginaAtual > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(paginaAtual - 1)"
                           asp-route-codigoCotacao="@pesquisaCodigoCotacao"
                           asp-route-safra="@pesquisaSafra"
                           asp-route-cultura="@pesquisaCultura"
                           asp-route-municipio="@pesquisaMunicipio"
                           asp-route-dataCotacao="@pesquisaDataCotacao"
                           asp-route-cpfCliente="@pesquisaCpf">Anterior</a>
                    </li>
                }

                @for (var i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == paginaAtual ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@i"
                           asp-route-codigoCotacao="@pesquisaCodigoCotacao"
                           asp-route-safra="@pesquisaSafra"
                           asp-route-cultura="@pesquisaCultura"
                           asp-route-municipio="@pesquisaMunicipio"
                           asp-route-dataCotacao="@pesquisaDataCotacao"
                           asp-route-cpfCliente="@pesquisaCpf">@i</a>
                    </li>
                }

                @if (paginaAtual < totalPaginas)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(paginaAtual + 1)"
                           asp-route-codigoCotacao="@pesquisaCodigoCotacao"
                           asp-route-safra="@pesquisaSafra"
                           asp-route-cultura="@pesquisaCultura"
                           asp-route-municipio="@pesquisaMunicipio"
                           asp-route-dataCotacao="@pesquisaDataCotacao"
                           asp-route-cpfCliente="@pesquisaCpf">Próximo</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

<!-- Modal de Confirmação Insucesso -->
<div class="modal fade" id="modalConfirmacao" tabindex="-1" role="dialog" aria-labelledby="modalConfirmacaoLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalConfirmacaoLabel">Confirmar Insucesso</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Deseja realmente marcar a cotação como insucesso?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary fecharModal" data-dismiss="modal">Não</button>
                <button type="button" class="btn btn-danger" id="btnConfirmarInsucesso">Sim</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Confirmação Exclusão -->
<div class="modal fade" id="modalConfirmacaoExclusao" tabindex="-1" role="dialog" aria-labelledby="modalConfirmacaoExclusaoLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalConfirmacaoExclusaoLabel">Confirmar Exclusão</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Deseja realmente excluir esta cotação? Esta ação não pode ser desfeita.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary fecharModal" data-dismiss="modal">Não</button>
                <button type="button" class="btn btn-danger" id="btnConfirmarExclusao">Sim, Excluir</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let cotacaoId;

        function confirmarInsucesso(id) {
            cotacaoId = id;
            $('#modalConfirmacao').modal('show');
        }
        function confirmarExclusao(id) {
            cotacaoId = id;
            $('#modalConfirmacaoExclusao').modal('show');
        }
        function reabrirCotacao(id) {
            if (confirm('Deseja realmente reabrir esta cotação?')) {
                $.ajax({
                    url: '@Url.Action("Reabrir", "CotacaoAgricola")',
                    type: 'POST',
                    data: { id: id },
                    success: function(result) {
                        if (result.success) {
                            window.location.reload();
                        } else {
                            alert(result.message || 'Erro ao reabrir cotação.');
                        }
                    },
                    error: function() {
                        alert('Erro ao reabrir cotação. Por favor, tente novamente.');
                    }
                });
            }
        }
        $('.fecharModal').off("click").on("click", function() {
            $('#modalConfirmacao').modal('hide');
            $('#modalConfirmacaoExclusao').modal('hide');
        });
        $('#btnConfirmarInsucesso').off("click").on("click", function() {
            $.ajax({
                url: '@Url.Action("RegistrarInsucesso", "CotacaoAgricola")',
                type: 'POST',
                data: { id: cotacaoId },
                success: function(result) {
                    $('#modalConfirmacao').modal('hide');
                    window.location.reload();
                },
                error: function(error) {
                    alert('Erro ao registrar insucesso. Por favor, tente novamente.');
                }
            });
        });
        $('#btnConfirmarExclusao').off("click").on("click", function() {
            $.ajax({
                url: '@Url.Action("Excluir", "CotacaoAgricola")',
                type: 'POST',
                data: { id: cotacaoId },
                success: function(result) {
                    $('#modalConfirmacaoExclusao').modal('hide');
                    window.location.reload();
                },
                error: function() {
                    alert('Erro ao excluir cotação. Por favor, tente novamente.');
                }
            });
        });
    </script>
}
