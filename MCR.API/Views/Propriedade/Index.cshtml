@using System.Collections.Generic
@using System.Globalization;
@model IList<MCR.API.Entities.PropriedadeEntity>
@{
    ViewData["Title"] = "Propriedades";
    var pesquisaNome = ViewBag.PesquisaNome as string;
    var pesquisaCidade = ViewBag.PesquisaCidade as string;
    var pesquisaEstado = ViewBag.PesquisaEstado as string;
    var pesquisaAtivoInativo = ViewBag.PesquisaAtivoInativo as string ?? "Todos";
    var paginaAtual = ViewBag.PaginaAtual as int? ?? 1;
    var totalPaginas = ViewBag.TotalPaginas as int? ?? 0;
}
<div class="form-box">
    <h4 class="form-title form-box-title justify-content-center align-items-center">Propriedades</h4>
    <br />
    <div class="row">
        <div class="col-md-2">
            <a asp-action="Cadastrar" asp-controller="Propriedade" class="btn btn-secondary rounded-pill">
                Cadastrar
            </a>
        </div>
    </div>
    <br />
    <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)">
        <div class="card-body" style="color: var(--color-primary)">
            <h6>Filtros</h6>
            <br />
            <form asp-action="Index" method="get">
                <div class="row">
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <div class="form-group">
                            <label for="dataHoraCotacaoInicio">Nome</label>
                            <input type="text" class="form-control"
                                   name="pesquisaNome"
                                   value="@pesquisaNome" />
                            <label for="dataHoraCotacaoInicio">Cidade</label>
                            <input type="text" class="form-control"
                                   name="pesquisaCidade"
                                   value="@pesquisaCidade" />
                            <label for="dataHoraCotacaoInicio">Estado</label>
                            <select class="form-select form-dropdownlist" aria-label="TempoVigenciaSeguro" name="pesquisaEstado">
                                <option value="">Selecione um estado</option>
                                <option value="AC">Acre (AC)</option>
                                <option value="AL">Alagoas (AL)</option>
                                <option value="AP">Amapá (AP)</option>
                                <option value="AM">Amazonas (AM)</option>
                                <option value="BA">Bahia (BA)</option>
                                <option value="CE">Ceará (CE)</option>
                                <option value="DF">Distrito Federal (DF)</option>
                                <option value="ES">Espírito Santo (ES)</option>
                                <option value="GO">Goiás (GO)</option>
                                <option value="MA">Maranhão (MA)</option>
                                <option value="MT">Mato Grosso (MT)</option>
                                <option value="MS">Mato Grosso do Sul (MS)</option>
                                <option value="MG">Minas Gerais (MG)</option>
                                <option value="PA">Pará (PA)</option>
                                <option value="PB">Paraíba (PB)</option>
                                <option value="PR">Paraná (PR)</option>
                                <option value="PE">Pernambuco (PE)</option>
                                <option value="PI">Piauí (PI)</option>
                                <option value="RJ">Rio de Janeiro (RJ)</option>
                                <option value="RN">Rio Grande do Norte (RN)</option>
                                <option value="RS">Rio Grande do Sul (RS)</option>
                                <option value="RO">Rondônia (RO)</option>
                                <option value="RR">Roraima (RR)</option>
                                <option value="SC">Santa Catarina (SC)</option>
                                <option value="SP">São Paulo (SP)</option>
                                <option value="SE">Sergipe (SE)</option>
                                <option value="TO">Tocantins (TO)</option>
                            </select>
                        </div>
                    </div>
                    <br />
                    <div class="col-sm-12 col-md-3 col-lg-3">
                        <div class="form-group">
                            <label for="corretoraId">Ativo?</label>
                            <select class="form-select form-dropdownlist" name="pesquisaAtivoInativo">
                                <option value="Todos">Todos</option>
                                <option value="Sim">Sim</option>
                                <option value="Não">Não</option>
                            </select>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <br />
                        <button type="submit" class="btn btn-primary">Filtrar</button>
                    </div>
                    <br />
                </div>
            </form>
        </div>
    </div>
    <br />
    <div style="overflow-x:auto;">
        <table id="tblCadastro" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Cidade/Estado</th>
                    <th>Área Total</th>
                    <th>Ativo?</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0 && Model[0].Sucesso)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Nome</td>
                            <td>@($"{item.Cidade}/{item.Estado}")</td>
                            <td>@item.SomaAreaTotalTalhao.FormatAreaHectaresVisualizacao() ha</td>
                            @if (item.Ativo)
                            {
                                <td><span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Ativo</span></td>
                            }
                            else
                            {
                                <td><span class="badge bg-danger"><i class="bi bi-exclamation-octagon me-1"></i> Inativo</span></td>
                            }
                            <td>
                                <a asp-action="Gerenciar" asp-route-id="@item.Id" class="btn btn-info btn-sm">Gerenciar</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>

    <div style="overflow-x:auto;">
        <nav aria-label="Page navigation">
            <ul class="pagination">
                @if (paginaAtual > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(paginaAtual - 1)"
                           asp-route-pesquisaAtivoInativo="@pesquisaAtivoInativo"
                           asp-route-pesquisaNome="@pesquisaNome"
                           asp-route-pesquisaCidade="@pesquisaCidade"
                           asp-route-pesquisaEstado="@pesquisaEstado">Anterior</a>
                    </li>
                }

                @for (var i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == paginaAtual ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@i"
                           asp-route-pesquisaAtivoInativo="@pesquisaAtivoInativo"
                           asp-route-pesquisaNome="@pesquisaNome"
                           asp-route-pesquisaCidade="@pesquisaCidade"
                           asp-route-pesquisaEstado="@pesquisaEstado">@i</a>
                    </li>
                }

                @if (paginaAtual < totalPaginas)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(paginaAtual + 1)"
                           asp-route-pesquisaAtivoInativo="@pesquisaAtivoInativo"
                           asp-route-pesquisaNome="@pesquisaNome"
                           asp-route-pesquisaCidade="@pesquisaCidade"
                           asp-route-pesquisaEstado="@pesquisaEstado">Próximo</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
