@model MCR.API.Models.MonitoramentoModel

@{
    var config = Model?.Configuracao;
    var isEnabled = config?.Enabled ?? false;
    var statusBadge = isEnabled ? "bg-success" : "bg-secondary";
    var statusText = isEnabled ? "Ativo" : "Inativo";
    var propertyId = Model?.Propriedade?.Id ?? Guid.Empty;
    var talhoes = Model?.Talhoes ?? new List<MCR.API.Entities.TalhaoEntity>();
    var cenas = Model?.CenasSatelite ?? new List<MCR.API.Entities.SatelliteSceneEntity>();
    var ultimaAnalise = Model?.UltimaAnalise;
}

<div class="card pt-3 mt-3" style="border-radius: 15px; border-color: var(--color-primary)">
    <div class="card-header d-flex justify-content-between align-items-center" style="color: var(--color-primary)">
        <h6 class="mb-0">
            <i class="bi bi-satellite"></i> Monitoramento da Lavoura
            <span class="badge bg-warning text-dark ms-2" style="font-size: 0.65em;">Beta</span>
        </h6>
        <span id="monitoringStatusBadge" class="badge @statusBadge">@statusText</span>
    </div>
    <div class="card-body">

        <!-- Dados da Propriedade -->
        <div class="card mb-3" style="border-radius: 10px; border-color: #e9ecef;">
            <div class="card-body py-2">
                <div class="row">
                    <div class="col-md-3">
                        <small class="text-muted d-block">Propriedade</small>
                        <strong>@(Model?.Propriedade?.Nome ?? "-")</strong>
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted d-block">Município</small>
                        <span>@(Model?.Propriedade?.Cidade ?? "-")</span>
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted d-block">Área Total</small>
                        <span>@(Model?.Propriedade?.SomaAreaTotalTalhao.ToString("F2") ?? "0") ha</span>
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted d-block">Talhões</small>
                        <span class="badge bg-info">@talhoes.Count registrado(s)</span>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted d-block">Última atualização</small>
                        <span>@(config?.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Nunca")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botões de Configuração -->
        <div class="d-flex gap-2 mb-3">
            @if (isEnabled)
            {
                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill"
                        onclick="desativarMonitoramento('@propertyId')" id="btnDesativarMonitoramento">
                    <i class="bi bi-pause-circle"></i> Desativar Monitoramento
                </button>
            }
            else
            {
                <button type="button" class="btn btn-success btn-sm rounded-pill"
                        onclick="ativarMonitoramento('@propertyId')" id="btnAtivarMonitoramento">
                    <i class="bi bi-play-circle"></i> Ativar Monitoramento
                </button>
            }
        </div>

        <!-- Alertas -->
        @if (Model?.Alertas != null && Model.Alertas.Any(a => !a.Viewed))
        {
            <div id="monitoringAlerts">
                @foreach (var alerta in Model.Alertas.Where(a => !a.Viewed))
                {
                    var alertClass = alerta.Severity == "Alta" ? "alert-danger" :
                                    alerta.Severity == "Média" ? "alert-warning" : "alert-info";
                    <div class="alert @alertClass alert-dismissible fade show" role="alert" style="border-radius: 10px;">
                        <strong><i class="bi bi-exclamation-triangle"></i> @alerta.Severity:</strong>
                        @alerta.Message
                        <small class="text-muted ms-2">@alerta.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        <button type="button" class="btn-close" onclick="marcarAlertaVisualizado('@alerta.Id', this)" aria-label="Fechar"></button>
                    </div>
                }
            </div>
        }

        <!-- Painel Saúde da Lavoura -->
        @if (ultimaAnalise != null)
        {
            var corClassificacao = ultimaAnalise.Classification == "Excelente" ? "#22c55e" :
                                   ultimaAnalise.Classification == "Bom" ? "#84cc16" :
                                   ultimaAnalise.Classification == "Atenção" ? "#eab308" : "#ef4444";
            var iconClassificacao = ultimaAnalise.Classification == "Excelente" ? "bi-circle-fill text-success" :
                                    ultimaAnalise.Classification == "Bom" ? "bi-circle-fill text-success" :
                                    ultimaAnalise.Classification == "Atenção" ? "bi-circle-fill text-warning" : "bi-circle-fill text-danger";

            <div class="card mb-3" style="border-radius: 10px; border-color: var(--color-primary); border-width: 2px;">
                <div class="card-header" style="background: linear-gradient(135deg, var(--color-primary), #1a5c3a); color: white; border-radius: 10px 10px 0 0;">
                    <h6 class="mb-0"><i class="bi bi-heart-pulse"></i> Saúde da Lavoura</h6>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-2">
                            <h3 style="color: @corClassificacao">@ultimaAnalise.HealthyAreaPercent.ToString("F0")%</h3>
                            <small class="text-muted">Área Saudável</small>
                            <br /><span class="badge" style="background-color: @corClassificacao; color: white;">@ultimaAnalise.Classification</span>
                        </div>
                        <div class="col-md-2">
                            <h4>@ultimaAnalise.AverageNdvi.ToString("F2")</h4>
                            <small class="text-muted">NDVI Médio</small>
                        </div>
                        <div class="col-md-2">
                            <h5 class="text-success">@ultimaAnalise.HealthyAreaPercent.ToString("F1")%</h5>
                            <small class="text-muted">Área Saudável</small>
                        </div>
                        <div class="col-md-2">
                            <h5 class="text-danger">@ultimaAnalise.CriticalAreaPercent.ToString("F1")%</h5>
                            <small class="text-muted">Área Crítica</small>
                        </div>
                        <div class="col-md-2">
                            <h6>@ultimaAnalise.AcquisitionDate.ToString("dd/MM/yyyy")</h6>
                            <small class="text-muted">Última Imagem</small>
                        </div>
                        <div class="col-md-2">
                            <small class="text-muted d-block">Min / Max NDVI</small>
                            <span class="text-danger">@ultimaAnalise.MinimumNdvi.ToString("F2")</span> /
                            <span class="text-success">@ultimaAnalise.MaximumNdvi.ToString("F2")</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(ultimaAnalise.PreviewImageBase64))
                    {
                        <hr />
                        <div class="text-center">
                            <h6 style="color: var(--color-primary)"><i class="bi bi-map"></i> Mapa NDVI</h6>
                            <img src="data:image/png;base64,@ultimaAnalise.PreviewImageBase64"
                                 class="img-fluid rounded"
                                 style="max-height: 400px; border: 1px solid #dee2e6;"
                                 alt="Mapa NDVI" />
                            <div class="mt-2">
                                <small class="text-muted">
                                    <span style="color: #dc3545;">■</span> Crítico
                                    <span style="color: #eab308;">■</span> Atenção
                                    <span style="color: #84cc16;">■</span> Bom
                                    <span style="color: #22c55e;">■</span> Excelente
                                </small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Busca de Imagens Satélite -->
        <div class="card mb-3" style="border-radius: 10px; border-color: var(--color-primary);">
            <div class="card-header" style="background-color: var(--color-primary); color: white; border-radius: 10px 10px 0 0;">
                <h6 class="mb-0"><i class="bi bi-search"></i> Busca de Imagens Satélite (CBERS-4A MUX)</h6>
            </div>
            <div class="card-body">
                @if (!isEnabled)
                {
                    <div class="alert alert-secondary mb-0" style="border-radius: 10px;">
                        <i class="bi bi-info-circle"></i> Ative o monitoramento para buscar imagens satélite.
                    </div>
                }
                else if (!talhoes.Any())
                {
                    <div class="alert alert-warning mb-0" style="border-radius: 10px;">
                        <i class="bi bi-exclamation-triangle"></i> Nenhum talhão cadastrado para esta propriedade.
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label small">Talhão</label>
                            <select id="selTalhao" class="form-select form-select-sm">
                                <option value="">Selecione o talhão</option>
                                @foreach (var t in talhoes)
                                {
                                    <option value="@t.Id" data-kml="@(!string.IsNullOrEmpty(t.KmlTalhao) ? "sim" : "nao")">
                                        @t.Nome (@t.Area ha) @(!string.IsNullOrEmpty(t.KmlTalhao) ? "" : " ⚠️ sem polígono")
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Data Início</label>
                            <input type="date" id="txtDataInicio" class="form-control form-control-sm"
                                   value="@DateTime.Now.AddMonths(-3).ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Data Fim</label>
                            <input type="date" id="txtDataFim" class="form-control form-control-sm"
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Cobertura Nuvens Máx.</label>
                            <input type="number" id="txtNuvemMax" class="form-control form-control-sm"
                                   value="@(config?.CloudLimit ?? 20)" min="0" max="100" step="5" />
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="button" class="btn btn-primary btn-sm rounded-pill w-100"
                                    onclick="buscarCenasSatelite('@propertyId')" id="btnBuscarCenas">
                                <i class="bi bi-satellite"></i> Buscar Cenas
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Histórico de Análises NDVI -->
        @if (Model?.Analises != null && Model.Analises.Any())
        {
            <h6 style="color: var(--color-primary)"><i class="bi bi-clock-history"></i> Histórico de Análises</h6>
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-primary">
                        <tr>
                            <th>Data Imagem</th>
                            <th>NDVI Médio</th>
                            <th>Classificação</th>
                            <th>Área Saudável</th>
                            <th>Área Crítica</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var analise in Model.Analises.Take(10))
                        {
                            var cor = analise.Classification == "Excelente" ? "#22c55e" :
                                      analise.Classification == "Bom" ? "#84cc16" :
                                      analise.Classification == "Atenção" ? "#eab308" : "#ef4444";
                            <tr>
                                <td>@analise.AcquisitionDate.ToString("dd/MM/yyyy")</td>
                                <td><strong>@analise.AverageNdvi.ToString("F2")</strong></td>
                                <td><span class="badge" style="background-color: @cor; color: white;">@analise.Classification</span></td>
                                <td class="text-success">@analise.HealthyAreaPercent.ToString("F1")%</td>
                                <td class="text-danger">@analise.CriticalAreaPercent.ToString("F1")%</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(analise.PreviewImageBase64))
                                    {
                                        <button type="button" class="btn btn-outline-info btn-sm rounded-pill"
                                                onclick="visualizarMapa('@analise.Id')">
                                            <i class="bi bi-map"></i> Mapa
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Cenas Satélite Disponíveis -->
        <h6 style="color: var(--color-primary)"><i class="bi bi-collection"></i> Cenas Satélite Disponíveis</h6>
        @if (cenas.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-primary">
                        <tr>
                            <th>Cena</th>
                            <th>Data</th>
                            <th>Cobertura Nuvem</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cena in cenas)
                        {
                            <tr>
                                <td><small>@cena.SceneId</small></td>
                                <td>@cena.AcquisitionDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge @(cena.CloudCover > 20 ? "bg-warning text-dark" : "bg-info")">
                                        @(cena.CloudCover?.ToString("F1") ?? "-")%
                                    </span>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-success btn-sm rounded-pill me-1"
                                            onclick="processarCena('@cena.Id', '@cena.TalhaoId')">
                                        <i class="bi bi-cpu"></i> Processar NDVI
                                    </button>
                                    @if (!string.IsNullOrEmpty(cena.AssetUrl))
                                    {
                                        <a href="@cena.AssetUrl" target="_blank" class="btn btn-outline-info btn-sm rounded-pill">
                                            <i class="bi bi-box-arrow-up-right"></i> COG
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-3">
                <i class="bi bi-cloud" style="font-size: 2rem; color: #adb5bd;"></i>
                <p class="text-muted mt-2 mb-0">Nenhuma cena encontrada. Use a busca acima para consultar o catálogo STAC.</p>
            </div>
        }

        <!-- Histórico de Execuções (Mock) -->
        @if (Model?.Execucoes != null && Model.Execucoes.Any())
        {
            <hr />
            <h6 style="color: var(--color-primary)"><i class="bi bi-graph-up"></i> Histórico de Execuções (Simuladas)</h6>
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-primary">
                        <tr>
                            <th>Data</th>
                            <th>Satélite</th>
                            <th>Cobertura Nuvem</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exec in Model.Execucoes.Take(5))
                        {
                            <tr>
                                <td>@exec.ExecutionDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="badge bg-info">@(exec.Satellite ?? "-")</span></td>
                                <td>
                                    <span class="badge @(exec.CloudCover > 20 ? "bg-warning text-dark" : "bg-info")">
                                        @(exec.CloudCover?.ToString("F1") ?? "-")%
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(exec.Status == "Concluído" ? "bg-success" : exec.Status == "Falha" ? "bg-danger" : "bg-warning text-dark")">
                                        @exec.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal Mapa NDVI -->
<div class="modal fade" id="modalMapaNdvi" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius: 15px;">
            <div class="modal-header" style="background-color: var(--color-primary); color: white;">
                <h6 class="modal-title"><i class="bi bi-map"></i> Mapa NDVI</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center" id="modalMapaContent">
            </div>
        </div>
    </div>
</div>
