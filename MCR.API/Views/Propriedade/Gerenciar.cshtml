}

// Função para carregar a aba de monitoramento
function carregarMonitoramento() {
    var propertyId = document.querySelector('input[name="Propriedade.Id"]')?.value;
    if (!propertyId) return;

    var container = document.getElementById('monitoramentoContainer');
    if (!container) return;

    fetch('/Monitoramento/ObterMonitoramento?propertyId=' + propertyId)
        .then(response => {
            if (!response.ok) throw new Error('Erro ao carregar monitoramento');
            return response.text();
        })
        .then(html => {
            container.innerHTML = html;
        })
        .catch(error => {
            console.error('Erro ao carregar monitoramento:', error);
            container.innerHTML = '<div class="alert alert-warning text-center" style="border-radius: 15px;">' +
                '<i class="bi bi-exclamation-triangle"></i> Não foi possível carregar o monitoramento.' +
                '</div>';
        });
}
