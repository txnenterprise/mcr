function buscarCenasSatelite(propertyId) {
    var selTalhao = document.getElementById('selTalhao');
    var dataInicio = document.getElementById('txtDataInicio').value;
    var dataFim = document.getElementById('txtDataFim').value;
    var nuvemMax = document.getElementById('txtNuvemMax').value;
    if (!selTalhao.value) { Swal.fire({ title: 'Atenção!', text: 'Selecione um talhão.', icon: 'warning', confirmButtonColor: '#ffc107' }); return; }
    var selectedOption = selTalhao.options[selTalhao.selectedIndex];
    if (selectedOption.getAttribute('data-kml') === 'nao') { Swal.fire({ title: 'Polígono não cadastrado', text: 'Este talhão não possui polígono (KML). Cadastre o polígono antes de buscar imagens satélite.', icon: 'warning', confirmButtonColor: '#ffc107' }); return; }
    if (!dataInicio || !dataFim) { Swal.fire({ title: 'Atenção!', text: 'Informe o período de busca.', icon: 'warning', confirmButtonColor: '#ffc107' }); return; }
    var btn = document.getElementById('btnBuscarCenas');
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Buscando...';
    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    var params = new URLSearchParams({ propertyId: propertyId, talhaoId: selTalhao.value, dataInicio: dataInicio + 'T00:00:00', dataFim: dataFim + 'T23:59:59', nuvemMaxima: nuvemMax || '20' });
    fetch('/Monitoramento/BuscarCenasSatelite?' + params.toString(), {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token }
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) { Swal.fire({ title: 'Busca Concluída!', text: data.message, icon: 'success', confirmButtonColor: '#28a745' }).then(() => location.reload()); }
        else { Swal.fire({ title: 'Erro!', text: data.message, icon: 'error', confirmButtonColor: '#dc3545' }); }
    })
    .catch(() => { Swal.fire({ title: 'Erro!', text: 'Erro de conexão com o servidor.', icon: 'error', confirmButtonColor: '#dc3545' }); })
    .finally(() => { btn.disabled = false; btn.innerHTML = '<i class="bi bi-satellite"></i> Buscar Cenas'; });
}

function processarCena(sceneId, talhaoId) {
    Swal.fire({
        title: 'Processar NDVI?',
        html: 'O sistema irá baixar as bandas B7 e B8, calcular o NDVI e gerar o mapa de saúde da lavoura.<br><br><small>Isso pode levar alguns minutos.</small>',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#28a745',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Sim, processar',
        cancelButtonText: 'Cancelar'
    }).then((result) => {
        if (result.isConfirmed) {
            Swal.fire({ title: 'Processando...', html: 'Baixando bandas e calculando NDVI...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            fetch('/Monitoramento/ProcessarCena', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body: 'sceneId=' + sceneId + '&talhaoId=' + talhaoId
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    var d = data.data;
                    Swal.fire({
                        title: 'Análise Concluída!',
                        html: '<strong>Classificação:</strong> ' + d.classification +
                              '<br><strong>NDVI Médio:</strong> ' + d.averageNdvi +
                              '<br><strong>Área Saudável:</strong> ' + d.healthyAreaPercent + '%' +
                              '<br><strong>Área Crítica:</strong> ' + d.criticalAreaPercent + '%',
                        icon: 'success',
                        confirmButtonColor: '#28a745'
                    }).then(() => location.reload());
                } else {
                    Swal.fire({ title: 'Erro!', text: data.message, icon: 'error', confirmButtonColor: '#dc3545' });
                }
            })
            .catch(() => { Swal.fire({ title: 'Erro!', text: 'Erro de conexão.', icon: 'error', confirmButtonColor: '#dc3545' }); });
        }
    });
}

function visualizarMapa(analysisId) {
    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    fetch('/Monitoramento/ObterAnalise?analysisId=' + analysisId)
    .then(r => r.json())
    .then(data => {
