@{
    ViewData["Title"] = "Query Tool SQL";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Query Tool SQL - Executar SQL</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container-main {
            max-width: 1400px;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 25px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header .badge {
            background: rgba(255,255,255,0.2);
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: normal;
        }

        .content {
            padding: 30px;
        }

        .info-box {
            background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
            border-left: 4px solid #2196f3;
            padding: 20px;
            margin-bottom: 25px;
            border-radius: 8px;
        }

        .info-box h5 {
            color: #1976d2;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .info-box ul {
            margin: 0;
            padding-left: 20px;
        }

        .info-box li {
            margin-bottom: 8px;
            color: #424242;
        }

        .editor-container {
            margin-bottom: 25px;
        }

        .editor-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
            padding: 12px 15px;
            background: #f5f5f5;
            border-radius: 8px 8px 0 0;
        }

        .editor-toolbar h5 {
            margin: 0;
            color: #333;
            font-size: 16px;
        }

        #sqlEditor {
            width: 100%;
            min-height: 400px;
            font-family: 'Courier New', 'Consolas', monospace;
            font-size: 14px;
            padding: 20px;
            border: 2px solid #e0e0e0;
            border-radius: 0 0 8px 8px;
            resize: vertical;
            background: #fafafa;
            line-height: 1.6;
            tab-size: 4;
        }

        #sqlEditor:focus {
            outline: none;
            border-color: #667eea;
            background: white;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .btn-execute {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 12px 35px;
            font-size: 16px;
            font-weight: 600;
            color: white;
            border-radius: 8px;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-execute:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn-execute:active {
            transform: translateY(0);
        }

        .btn-execute:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        .results-section {
            margin-top: 30px;
        }

        .alert {
            padding: 18px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            border: none;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .alert-success {
            background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
            color: #155724;
        }

        .alert-danger {
            background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
            color: #721c24;
        }

        .alert pre {
            margin: 10px 0 0 0;
            white-space: pre-wrap;
            word-wrap: break-word;
            font-family: 'Courier New', monospace;
            font-size: 13px;
            background: rgba(0,0,0,0.05);
            padding: 12px;
            border-radius: 4px;
        }

        .results-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 8px;
        }

        .results-header h5 {
            margin: 0;
            color: #333;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .table-container {
            max-height: 600px;
            overflow: auto;
            border: 1px solid #dee2e6;
            border-radius: 8px;
        }

        .table {
            margin: 0;
            font-size: 13px;
        }

        .table thead th {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px 15px;
            position: sticky;
            top: 0;
            z-index: 10;
            font-weight: 600;
            border: none;
        }

        .table tbody td {
            padding: 10px 15px;
            border-bottom: 1px solid #e9ecef;
            vertical-align: middle;
        }

        .table tbody tr:hover {
            background-color: #f8f9fa;
        }

        .table tbody tr:last-child td {
            border-bottom: none;
        }

        .empty-result {
            text-align: center;
            padding: 60px 20px;
            color: #6c757d;
        }

        .empty-result i {
            font-size: 64px;
            margin-bottom: 20px;
            opacity: 0.5;
        }

        .loading {
            display: none;
            text-align: center;
            padding: 40px;
        }

        .loading.show {
            display: block;
        }

        .spinner-border {
            width: 3rem;
            height: 3rem;
            border-width: 0.3em;
        }

        .shortcuts {
            font-size: 12px;
            color: #6c757d;
            margin-top: 10px;
        }

        .shortcuts kbd {
            background: #e9ecef;
            padding: 3px 6px;
            border-radius: 3px;
            font-family: monospace;
            font-size: 11px;
        }
    </style>
</head>
<body>
    <div class="container-main">
        <div class="header">
            <h1>
                <i class="bi bi-code-square"></i>
                Query Tool SQL
                <span class="badge">PostgreSQL</span>
            </h1>
            <div>
                <button type="button" class="btn-execute" id="btnExecute" onclick="executeQuery()">
                    <i class="bi bi-play-fill"></i>
                    Executar SQL
                </button>
            </div>
        </div>

        <div class="content">
            <div class="info-box">
                <h5>
                    <i class="bi bi-info-circle"></i>
                    Instruções de Uso
                </h5>
                <ul>
                    <li>Digite seus comandos SQL no editor abaixo (CREATE TABLE, SELECT, INSERT, UPDATE, DELETE, etc.)</li>
                    <li>Para queries SELECT, os resultados serão exibidos em uma tabela formatada</li>
                    <li>Para comandos DDL/DML (CREATE, INSERT, UPDATE, DELETE), será exibida a quantidade de linhas afetadas</li>
                    <li>Você pode executar múltiplos comandos separados por ponto e vírgula</li>
                    <li>Use <kbd>F5</kbd> para executar rapidamente ou <kbd>Tab</kbd> para indentar</li>
                </ul>
            </div>

            <div class="editor-container">
                <div class="editor-toolbar">
                    <h5><i class="bi bi-file-code"></i> Editor SQL</h5>
                    <div class="shortcuts">
                        <kbd>F5</kbd> Executar | <kbd>Tab</kbd> Indentar
                    </div>
                </div>
                <textarea 
                    id="sqlEditor" 
                    placeholder="Digite seu SQL aqui...&#10;&#10;Exemplo:&#10;CREATE TABLE exemplo (&#10;    id SERIAL PRIMARY KEY,&#10;    nome VARCHAR(100) NOT NULL,&#10;    criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP&#10;);&#10;&#10;-- Ou uma query SELECT:&#10;SELECT * FROM exemplo;"
                    autofocus></textarea>
            </div>

            <div id="loading" class="loading">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Executando...</span>
                </div>
                <p class="mt-3">Executando query, por favor aguarde...</p>
            </div>

            <div id="alertContainer"></div>

            <div id="resultsSection" class="results-section" style="display: none;">
                <div class="results-header">
                    <h5>
                        <i class="bi bi-table"></i>
                        Resultados da Query
                    </h5>
                    <span class="badge bg-primary" id="rowsCount">0 linha(s)</span>
                </div>
                <div class="table-container" id="tableContainer"></div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const sqlEditor = document.getElementById('sqlEditor');
        const btnExecute = document.getElementById('btnExecute');
        const loading = document.getElementById('loading');
        const alertContainer = document.getElementById('alertContainer');
        const resultsSection = document.getElementById('resultsSection');
        const tableContainer = document.getElementById('tableContainer');
        const rowsCount = document.getElementById('rowsCount');

        // F5 para executar
        sqlEditor.addEventListener('keydown', function(e) {
            if (e.key === 'F5') {
                e.preventDefault();
                executeQuery();
            }
            
            // Tab para indentação
            if (e.key === 'Tab') {
                e.preventDefault();
                const start = this.selectionStart;
                const end = this.selectionEnd;
                const value = this.value;
                this.value = value.substring(0, start) + '    ' + value.substring(end);
                this.selectionStart = this.selectionEnd = start + 4;
            }
        });

        // Auto-resize do textarea
        sqlEditor.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = (this.scrollHeight) + 'px';
        });

        async function executeQuery() {
            const script = sqlEditor.value.trim();
            
            if (!script) {
                showAlert('Por favor, insira um script SQL.', 'danger');
                return;
            }

            // Limpar resultados anteriores
            alertContainer.innerHTML = '';
            resultsSection.style.display = 'none';
            tableContainer.innerHTML = '';
            
            // Mostrar loading
            loading.classList.add('show');
            btnExecute.disabled = true;

            try {
                const response = await fetch('/SqlQuery/Execute', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ script: script })
                });

                const result = await response.json();

                if (result.success) {
                    if (result.isQuery) {
                        // Mostrar resultados em tabela
                        displayResults(result.data, result.rowsAffected);
                        showAlert(`Query executada com sucesso! ${result.rowsAffected} linha(s) retornada(s).`, 'success');
                    } else {
                        // Mostrar mensagem de sucesso para comandos DDL/DML
                        showAlert(result.message, 'success');
                    }
                } else {
                    showAlert(result.error || 'Erro ao executar o script.', 'danger');
                }
            } catch (error) {
                showAlert('Erro ao comunicar com o servidor: ' + error.message, 'danger');
            } finally {
                loading.classList.remove('show');
                btnExecute.disabled = false;
            }
        }

        function displayResults(data, rowCount) {
            if (!data || data.length === 0) {
                tableContainer.innerHTML = `
                    <div class="empty-result">
                        <i class="bi bi-inbox"></i>
                        <p>Nenhum resultado encontrado.</p>
                    </div>
                `;
                resultsSection.style.display = 'block';
                rowsCount.textContent = '0 linha(s)';
                return;
            }

            // Obter colunas
            const columns = Object.keys(data[0]);
            
            // Criar tabela
            let html = '<table class="table table-striped table-hover"><thead><tr>';
            columns.forEach(col => {
                html += `<th>${escapeHtml(col)}</th>`;
            });
            html += '</tr></thead><tbody>';

            data.forEach(row => {
                html += '<tr>';
                columns.forEach(col => {
                    const value = row[col];
                    html += `<td>${escapeHtml(value !== null && value !== undefined ? value.toString() : 'NULL')}</td>`;
                });
                html += '</tr>';
            });

            html += '</tbody></table>';
            
            tableContainer.innerHTML = html;
            resultsSection.style.display = 'block';
            rowsCount.textContent = `${rowCount} linha(s)`;
        }

        function showAlert(message, type) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type}`;
            alertDiv.innerHTML = `
                <strong><i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-triangle'}"></i> 
                ${type === 'success' ? 'Sucesso' : 'Erro'}:</strong>
                <pre>${escapeHtml(message)}</pre>
            `;
            alertContainer.appendChild(alertDiv);
            
            // Scroll para o alerta
            alertDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
</body>
</html>

