@model MCR.API.Entities.ParametrizacaoRiscoEntity
@{
    ViewData["Title"] = "Riscos - Parametrizações - Visualizar";
}
<div class="form-box">
    <h4 class="form-title form-box-title justify-content-center align-items-center">Riscos - Parametrizações - Visualizar</h4>
    <br /><br />
    <div class="row">
        <div class="col-md-2">
            <a asp-action="Index" asp-controller="Parametrizacao" class="default-btn btn d-flex justify-content-center align-items-center">
                Voltar
            </a>
        </div>
    </div>
    <br /><br />
    <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)">
        <div class="card-body" style="color: var(--color-primary)">
            <div class="row">
                <div class="col-sm-12 col-md-12 col-lg-8">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="Risco.EquipamentoOperaProximoAgua" id="EquipamentoOperaProximoAgua">
                        <label class="form-check-label" for="EquipamentoOperaProximoAgua">Equipamento opera próximo à agua?</label>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12 col-md-12 col-lg-8">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="Risco.SeguradoColaboradorOperador" id="SeguradoColaboradorOperador">
                        <label class="form-check-label" for="SeguradoColaboradorOperador">Operado pelo Segurado/Colaborador?</label>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />
    <br />
    @if (Model != null && !Model.Risco.Sucesso)
    {
        <br />
        <div class="alert alert-warning text-center" role="alert" style="color: #b59900; border-radius: 15px">
            <h6>Atenção!</h6>
            <h6>@Model.Risco.Mensagem</h6>
        </div>
    }
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var inputElements = document.querySelectorAll('input');
        inputElements.forEach(function (element) {
            if (element.type === 'checkbox') {
                element.disabled = true;
            } else {
                element.readOnly = true;
            }
        });
    });
</script>