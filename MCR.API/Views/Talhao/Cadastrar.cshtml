<script>
    document.addEventListener("DOMContentLoaded", function () {
        const propriedadeSelect = document.getElementById("PropriedadeId");
        const cepInput = document.getElementById("cep");
        const enderecoInput = document.getElementById("endereco");

        function carregarPropriedadeNoMapa(propriedadeId) {
            if (!propriedadeId) return;

            fetch(`/api/propriedades/${propriedadeId}`)
                .then((response) => response.json())
                .then((responseData) => {
                    var ok = responseData.success === true;
                    if (!ok || !responseData.data) {
                        alert(responseData.message || "Erro ao buscar propriedade.");
                        return;
                    }

                    var p = responseData.data;
                    var cep = p.cep || p.CEP || "";
                    var endereco = p.endereco || p.Endereco || "";
                    cepInput.value = cep;
                    enderecoInput.value = endereco;

                    window.propriedadeCidade = (p.cidade || p.Cidade || "").trim();
                    window.propriedadeEstado = (p.estado || p.Estado || "").trim();

                    var enderecoStr = (p.endereco || p.Endereco || "").trim();
                    var cepStr = (p.cep || p.CEP || "").trim();
                    var queryEnderecoCompleto = enderecoStr + (cepStr ? ", " + cepStr : "");
                    if (!queryEnderecoCompleto) return;

                    var el = document.getElementById("propertyAddress");
                    if (el) el.value = queryEnderecoCompleto;
                    carregarMapa(queryEnderecoCompleto);
                })
                .catch((error) => console.error("Erro ao buscar propriedade:", error));
        }

        propriedadeSelect.addEventListener("change", function () {
            carregarPropriedadeNoMapa(propriedadeSelect.value);
        });

        if (window.propriedadeIdPreSelecionado && window.propriedadeIdPreSelecionado.length > 0) {
            propriedadeSelect.value = window.propriedadeIdPreSelecionado;
            carregarPropriedadeNoMapa(window.propriedadeIdPreSelecionado);
        }
    });
</script>

