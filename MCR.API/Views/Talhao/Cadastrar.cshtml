<script>
    document.addEventListener("DOMContentLoaded", function () {
        const areiaInput = document.getElementById("PercentualAreia");
        const silteInput = document.getElementById("PercentualSilte");
        const argilaInput = document.getElementById("PercentualArgila");
        const classeADElement = document.getElementById("classeAD");
        const tipoSoloSelect = document.getElementById("tipoSolo");
        const classificacaoSoloADSelect = document.getElementById("classificacaoSoloAD");

        // Ranges e classes de AD
        const rangesAD = [
            { min: 0, max: 0.33, classe: "AD 1" },
            { min: 0.34, max: 0.46, classe: "AD 2" },
            { min: 0.46, max: 0.61, classe: "AD 3" },
            { min: 0.61, max: 0.80, classe: "AD 4" },
            { min: 0.80, max: 1.06, classe: "AD 5" },
            { min: 1.06, max: Infinity, classe: "AD 6" }
        ];

        const calcularAD = () => {
            const areia = parseFloat(areiaInput.value.replace(",", ".")) || 0;
            const silte = parseFloat(silteInput.value.replace(",", ".")) || 0;
            const argila = parseFloat(argilaInput.value.replace(",", ".")) || 0;

            const somaTotal = areia + silte + argila;
            if (somaTotal !== 100) {
                classeADElement.textContent = "A soma dos percentuais deve ser 100%.";
                classeADElement.className = "text-danger";
                classificacaoSoloADSelect.value = "";
                tipoSoloSelect.value = "";
                return;
            }

            // Cálculo da Água Disponível (AD)
            const part1 = (0.3591 * (
                (-0.02128887 * areia) +
                (-0.01005814 * silte) +
                (-0.01901894 * argila) +
                (0.0001171219 * areia * silte) +
                (0.0002073924 * areia * argila) +
                (0.00006118707 * silte * argila) +
                (-0.000006373789 * areia * silte * argila)
            ));
            const part2 = 1 + part1;
            const part3 = part2 ** 2.78474;
            const ad = (part3 * 10).toFixed(2);

            // Seleção da classificação do solo com base no AD
            const classificacao = rangesAD.find(range => ad >= range.min && ad < range.max);
            classificacaoSoloADSelect.value = classificacao ? classificacao.classe : "";

            // Seleção do tipo de solo com base nas condições
            const diferencaAreiaArgila = areia - argila;
            if (argila >= 10 && argila < 15 && diferencaAreiaArgila >= 50) {
                tipoSoloSelect.value = "Tipo 1";
            } else if (argila >= 15 && argila < 35 && diferencaAreiaArgila < 50) {
                tipoSoloSelect.value = "Tipo 2";
            } else if (argila >= 35) {
                tipoSoloSelect.value = "Tipo 3";
            } else {
                tipoSoloSelect.value = ""; // Nenhum tipo se aplica
            }

            // Exibição do resultado AD
            classeADElement.textContent = `AD: ${ad}`;
        };

        // Eventos para calcular durante a digitação e ao sair do campo
        [areiaInput, silteInput, argilaInput].forEach(input => {
            input.addEventListener("input", calcularAD);
            input.addEventListener("blur", calcularAD);
        });
    });
</script>

