@model MCR.API.Models.ViewModels.TalhaoModel
@{
    ViewData["Title"] = "Talhão - Cadastrar";
}
<style>
    #map {
        width: 100%;
        height: 500px;
        margin-top: 20px;
    }

    #screenshotContainer {
        margin-top: 20px;
    }
</style>

<div class="form-box">
    <h4 class="form-title form-box-title justify-arquivo-center align-items-center">Talhão - Cadastrar</h4>
    <br /><br />
    <div class="row">
        <div class="col-md-2">
            <a asp-action="Index" asp-controller="Talhao" class="btn btn-secondary rounded-pill">
                Voltar
            </a>
        </div>
    </div>
    <br /><br />
    <form id="formCadastrarTalhao" asp-controller="Talhao" asp-action="Cadastrar" method="post">
        <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)">
            <div class="card-body" style="color: var(--color-primary)">
                <div class="row">
                    <div class="col-sm-12 col-md-3 col-lg-3">
                        <div class="form-floating">
                            <input type="text" class="form-control form-input form-control-placeholder" asp-for="Talhao.Nome" id="Nome" placeholder="Nome do Talhão">
                            <label for="Nome">Nome do Talhão</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-3 col-lg-3">
                        <div class="form-floating">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="Talhao.PossuiAnaliseFisicaSolo" id="PossuiAnaliseFisicaSolo">
                                <label class="form-check-label" for="flexSwitchCheckChecked">Análise Física do Solo?</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <div class="form-floating">
                            <input type="text" class="form-control form-input form-control-placeholder" asp-for="Talhao.PercentualAreia" id="PercentualAreia" placeholder="% Areia">
                            <label for="PercentualAreia">% Areia</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <div class="form-floating">
                            <input type="text" class="form-control form-input form-control-placeholder" asp-for="Talhao.PercentualSilte" id="PercentualSilte" placeholder="% Silte">
                            <label for="PercentualSilte">% Silte</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <div class="form-floating">
                            <input type="text" class="form-control form-input form-control-placeholder" asp-for="Talhao.PercentualArgila" id="PercentualArgila" placeholder="% Argila">
                            <label for="PercentualArgila">% Argila</label>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12 col-md-3 col-lg-3">
                        <h5 id="classeAD"></h5>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-md-2 col-lg-2 col-sm-12">
                        <p><span class="badge bg-secondary">AD0</span> Valores de AD menor do que 0,33 (solos nesta classe não são classificados para fins de risco climático).</p>
                        <p><span class="badge bg-info">AD6</span> Valores de AD maiores ou iguais a 1,40 mm/cm.</p>
                    </div>
                    <div class="col-md-2 col-lg-2 col-sm-12">
                        <p><span class="badge bg-warning text-dark">AD1</span> Valores de AD maiores ou iguais a 0,34 e menores que 0,46 mm/cm.</p>
                    </div>
                    <div class="col-md-2 col-lg-2 col-sm-12">
                        <p><span class="badge text-dark" style="background-color: #fbeab7">AD2</span> Valores de AD maiores ou iguais a 0,46 e menores que 0,61 mm/cm.</p>
                    </div>
                    <div class="col-md-2 col-lg-2 col-sm-12">
                        <p><span class="badge text-dark" style="background-color: #ffeb00">AD3</span> Valores de AD maiores ou iguais a 0,61 e menores que 0,80 mm/cm.</p>
                    </div>
                    <div class="col-md-2 col-lg-2 col-sm-12">
                        <p><span class="badge bg-success">AD4</span> Valores de AD maiores ou iguais a 0,80 e menores que 1,06 mm/cm.</p>
                    </div>
                    <div class="col-md-2 col-lg-2 col-sm-12">
                        <p><span class="badge bg-primary">AD5</span> Valores de AD maiores ou iguais a 1,06 e menores que 1,40 mm/cm.</p>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="TipoSolo" asp-for="Talhao.TipoSolo" id="tipoSolo">
                                <option value="">Selecione um Tipo de Solo</option>
                                <option value="Tipo 1">Tipo 1</option>
                                <option value="Tipo 2">Tipo 2</option>
                                <option value="Tipo 3">Tipo 3</option>
                            </select>
                            <label for="TipoSolo">Tipo de Solo</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="ClassificacaoSolo" asp-for="Talhao.ClassificacaoSolo" id="classificacaoSoloAD">
                                <option value="">Selecione uma Classificação do Solo</option>
                                <option value="AD 1">AD 1</option>
                                <option value="AD 2">AD 2</option>
                                <option value="AD 3">AD 3</option>
                                <option value="AD 4">AD 4</option>
                                <option value="AD 5">AD 5</option>
                                <option value="AD 6">AD 6</option>
                            </select>
                            <label for="ClassificacaoSolo">Classificação do Solo</label>
                        </div>
                    </div>
                </div>
                <br/>
                <br/>
                <div class="row">
                    <div class="col-sm-12 col-md-6 col-lg-6">
                        <label>
                            Selecione a propriedade para que o endereço e o mapa sejam carregados.
                            Depois, desenhe o polígono referente ao talhão para que os campos de latitude, longitude, roteiro de acesso e área sejam preenchidos.
                        </label>
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="PropriedadeId" asp-for="Talhao.PropriedadeId" id="PropriedadeId" asp-items="ViewBag.Propriedades">
                                <option value="">Propriedades</option>
                            </select>
                            <label>Propriedades</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="cep" placeholder="CEP" readonly>
                            <label for="cep">CEP</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="endereco" placeholder="Endereço" readonly>
                            <label for="endereco">Endereço</label>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-md-12 col-lg-12 col-sm-12">
                        <p class="text-muted small mb-1">Mapa em modo satélite. Use o controle no canto superior direito para alternar entre <strong>Mapa</strong>, <strong>Satélite</strong> e <strong>Híbrido</strong>. Use o ícone de polígono para desenhar o talhão. O polígono deve estar dentro do <strong>município da propriedade</strong> selecionada; caso contrário será exibido aviso e o desenho não será aceito. <strong>Errou o desenho?</strong> Clique em <strong>Apagar polígono</strong>.</p>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill" onclick="apagarPoligono()" title="Remove o polígono desenhado e limpa área, coordenadas e roteiro">
                                <i class="bi bi-trash"></i> Apagar polígono
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" onclick="centralizarNoEndereco()" title="Centraliza e dá zoom no endereço da propriedade selecionada">
                                <i class="bi bi-geo-alt"></i> Centralizar no endereço
                            </button>
                        </div>
                        <div id="map"></div>
                    </div>
                </div>
                <br />
                <!-- NOVA SEÇÃO: Importar KML -->
                <div class="row">
                    <div class="col-md-12 col-lg-12 col-sm-12">
                        <div class="card">
                            <div class="card-header">
                                <h6>Importar KML</h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-8">
                                        <div class="form-floating">
                                            <input type="file" class="form-control" id="kmlFileInput" accept=".kml" onchange="handleKmlFileUpload(event)">
                                            <label for="kmlFileInput">Selecione um arquivo KML</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <button type="button" class="btn btn-info rounded-pill" onclick="importKmlFromFile()">
                                            Importar KML
                                        </button>
                                        <button type="button" class="btn btn-secondary rounded-pill" onclick="clearImportedKml()">
                                            Limpar
                                        </button>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-md-12">
                                        <small class="text-muted">
                                            Você pode importar um arquivo KML para carregar automaticamente o polígono no mapa. O arquivo deve conter um ou mais polígonos válidos.
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12 col-md-3 col-lg-3">
                        <div class="form-floating">
                            <input type="text" class="form-control form-input form-control-placeholder" asp-for="Talhao.Latitude" id="Latitude" placeholder="Latitude">
                            <label for="Latitude">Latitude</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-3 col-lg-3">
                        <div class="form-floating">
                            <input type="text" class="form-control form-input form-control-placeholder" asp-for="Talhao.Longitude" id="Longitude" placeholder="Longitude">
                            <label for="Longitude">Longitude</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-3 col-lg-3">
                        <div class="form-floating">
                            <input type="text" class="form-control form-input form-control-placeholder" asp-for="Talhao.Area" id="Area" placeholder="Área">
                            <label for="Area">Área</label>
                        </div>
                    </div>
                    <br />
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-12">
                        <div class="form-floating">
                            <textarea class="form-control" asp-for="Talhao.RoteiroAcesso" id="RoteiroAcesso" placeholder="Roteiro de Acesso" style="height: 200px !important"></textarea>
                            <label for="RoteiroAcesso">Roteiro de Acesso</label>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-md-4 col-sm-12 col-lg-4">
                        <label>Imagem Capturada</label>
                        <img id="mapScreenshot" class="img-thumbnail" alt="Captura da Área" style="display: none;">
                    </div>
                    <div class="col-md-4 col-sm-12 col-lg-4">
                        <label>KML Gerado</label>
                        <textarea class="form-control" id="kmlOutput" rows="10" cols="50" readonly style="display: none;"></textarea>
                    </div>
                    <div class="col-md-2 col-sm-12 col-lg-2">
                        <a onclick="downloadFiles()" class="btn btn-primary rounded-pill">
                            Download
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <br />
        <input type="hidden" asp-for="ImageJson" id="imageJson" />
        <input type="hidden" asp-for="KmlJson" id="kmlJson" name="kmlJson" />
        
        <!-- Campos hidden para evitar erros de ModelState -->
        <input type="hidden" asp-for="ListaTalhoes" value="" />
        <input type="hidden" asp-for="ListaKmlFiles" value="" />
        <input type="hidden" asp-for="PaginaAtual" value="0" />
        <input type="hidden" asp-for="ItensPorPagina" value="0" />
        <input type="hidden" asp-for="TotalPaginas" value="0" />
        <input type="hidden" asp-for="PesquisaAtivoInativo" value="" />
        <input type="hidden" asp-for="PesquisaPropriedadeId" value="" />
        <input type="hidden" asp-for="ImagensJson" value="" />
        <input type="hidden" asp-for="KmlsJson" value="" />
        
        <div class="social-login">
            <button type="submit" class="btn btn-success rounded-pill">
                Salvar
            </button>
        </div>
    </form>
    @if (Model?.Talhao != null && !Model.Talhao.Sucesso)
    {
        <br />
        <div class="alert alert-warning text-center" role="alert" style="color: #b59900; border-radius: 15px" data-talhao-mensagem="@System.Net.WebUtility.HtmlEncode(Model.Talhao.Mensagem ?? "")">
            <h6>Atenção!</h6>
            <h6>@Model.Talhao.Mensagem</h6>
        </div>
    }
</div>

<input type="text" id="propertyAddress" placeholder="Digite o endereço da propriedade" style="width: 300px;" hidden>
<!-- Carrega a API do Google Maps com a biblioteca de desenho. Chave em appsettings.json (GoogleMaps:ApiKey) para produção sem aviso "For development purposes only". -->
<script src="https://maps.googleapis.com/maps/api/js?key=@(ViewBag.GoogleMapsApiKey ?? "AIzaSyBjUtP8FEbSpKjbU4JY6p9LU-vURNN7e48")&libraries=places,drawing,geometry&v=3.64"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script>
    // === LOGS DIAGNÓSTICO TALHÃO CADASTRAR (ver no Console do navegador: F12 > Console) ===
