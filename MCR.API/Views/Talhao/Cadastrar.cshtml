<script>
    document.addEventListener('DOMContentLoaded', function () {
        var form = document.getElementById('formCadastrarTalhao');
        if (!form) return;

        form.addEventListener('submit', function (e) {
            var nome = document.getElementById('Nome') && document.getElementById('Nome').value.trim();
            var propriedadeId = document.getElementById('PropriedadeId') && document.getElementById('PropriedadeId').value;
            var latitude = document.getElementById('Latitude') && document.getElementById('Latitude').value.trim();
            var longitude = document.getElementById('Longitude') && document.getElementById('Longitude').value.trim();
            var area = document.getElementById('Area') && document.getElementById('Area').value.trim();
            var tipoSolo = document.getElementById('tipoSolo') && document.getElementById('tipoSolo').value;
            var classificacaoSolo = document.getElementById('classificacaoSoloAD') && document.getElementById('classificacaoSoloAD').value;
            var roteiroAcesso = document.getElementById('RoteiroAcesso') && document.getElementById('RoteiroAcesso').value.trim();

            var faltando = [];
            if (!nome) faltando.push('Nome do Talhão');
            if (!propriedadeId) faltando.push('Propriedade');
            if (!latitude) faltando.push('Latitude');
            if (!longitude) faltando.push('Longitude');
            if (!area || parseFloat(String(area).replace(',', '.')) <= 0) faltando.push('Área (desenhe o polígono no mapa)');
            if (!tipoSolo) faltando.push('Tipo de Solo');
            if (!classificacaoSolo) faltando.push('Classificação do Solo');
            if (!roteiroAcesso) faltando.push('Roteiro de Acesso');

            if (faltando.length > 0) {
                e.preventDefault();
                console.warn('[Talhao Cadastrar] Submit bloqueado - campos faltando:', faltando);
                alert('Preencha os campos obrigatórios:\n\n• ' + faltando.join('\n• '));
                return;
            }

            var areaEl = document.getElementById('Area');
            if (areaEl && areaEl.value.indexOf(',') !== -1) {
                areaEl.value = areaEl.value.replace(',', '.');
            }

            var fd = new FormData(form);
            var dadosLog = {};
            fd.forEach(function (val, key) {
                if (key === 'ImageJson' || key === 'KmlJson') dadosLog[key] = val ? '(preenchido, ' + (String(val).length) + ' chars)' : '(vazio)';
                else dadosLog[key] = String(val).substring(0, 60);
            });
            console.log('[Talhao Cadastrar] Enviando formulário (POST) para:', form.action || window.location.href);
            console.log('[Talhao Cadastrar] Dados enviados:', dadosLog);
        });
    });
</script>

