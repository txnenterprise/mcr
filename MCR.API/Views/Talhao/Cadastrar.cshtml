        var msg = document.querySelector('[data-talhao-mensagem]');
        var origem = msg ? 'POST (retorno do servidor)' : 'GET (página nova)';
        var mensagemServidor = msg ? msg.getAttribute('data-talhao-mensagem') || '' : '';
        console.log('[Talhao Cadastrar] Página carregada - origem:', origem);
        if (mensagemServidor) console.log('[Talhao Cadastrar] Mensagem do servidor:', mensagemServidor);
        console.log('[Talhao Cadastrar] Dados no formulário (Model):', {
            Nome: "@(Model?.Talhao?.Nome != null ? (Model.Talhao.Nome ?? "").Replace("\\", "\\\\").Replace("\"", "\\\"") : "")",
            PropriedadeId: "@(Model?.Talhao?.PropriedadeId ?? Guid.Empty)",
            Area: "@(Model?.Talhao?.Area.ToString() ?? "")",
            Latitude: "@(Model?.Talhao?.Latitude ?? "")",
            Longitude: "@(Model?.Talhao?.Longitude ?? "")",
            ImageJsonLength: @(Model?.ImageJson != null ? Model.ImageJson.Length : 0),
            KmlJsonLength: @(Model?.KmlJson != null ? Model.KmlJson.Length : 0)
        });
    })();
</script>
<script>
    let map;
    let drawingManager;
    let selectedShape;
    let loadedPolygon = null; // Variável para armazenar o polígono carregado
    const geocoder = new google.maps.Geocoder();
    const directionsService = new google.maps.DirectionsService();
    const addressInput = document.getElementById("propertyAddress");
    const mapScreenshot = document.getElementById("mapScreenshot");
    const kmlOutput = document.getElementById("kmlOutput");
    const areaField = document.getElementById("Area");
    const latitudeField = document.getElementById("Latitude");
    const longitudeField = document.getElementById("Longitude");
    const roteiroAcessoField = document.getElementById("RoteiroAcesso");
    const imageJson = document.getElementById("imageJson");
    const kmlJson = document.getElementById("kmlJson");
    const tipoSoloAD = document.getElementById("TipoSoloAD");
    const classificacaoSoloAD = document.getElementById("ClassificacaoSoloAD");

    // Inicializa o mapa (modo satélite por padrão; controle no canto superior direito para alternar Mapa / Satélite / Híbrido)
    function initializeMap(lat = -14.235004, lng = -51.92528) {
        const mapOptions = {
            zoom: 5,
            center: new google.maps.LatLng(lat, lng),
            mapTypeId: 'satellite',
            mapTypeControl: true,
            mapTypeControlOptions: {
                style: google.maps.MapTypeControlStyle.HORIZONTAL_BAR,
                position: google.maps.ControlPosition.TOP_RIGHT
            }
        };
        map = new google.maps.Map(document.getElementById("map"), mapOptions);

        // Configura o gerenciador de desenho
        drawingManager = new google.maps.drawing.DrawingManager({
            drawingMode: google.maps.drawing.OverlayType.POLYGON,
            drawingControl: true,
            drawingControlOptions: {
                position: google.maps.ControlPosition.TOP_CENTER,
                drawingModes: ["polygon"],
            },
            polygonOptions: {
                editable: true,
                draggable: false,
            },
        });
        drawingManager.setMap(map);

        // Evento de finalização do desenho (com validação de município)
        google.maps.event.addListener(drawingManager, "overlaycomplete", function (event) {
            if (selectedShape) {
                selectedShape.setMap(null);
            }

            selectedShape = event.overlay;
            drawingManager.setDrawingMode(null);

            validarPoligonoNoMunicipio(selectedShape, function (valido, municipioEncontrado, mensagemErro) {
                if (!valido) {
                    selectedShape.setMap(null);
                    selectedShape = null;
                    var msg = mensagemErro || "O polígono está fora do município da propriedade.";
                    if (municipioEncontrado) msg += "\n\nMunicípio da propriedade: " + (window.propriedadeCidade || "") + "\nÁrea desenhada está em: " + municipioEncontrado;
                    msg += "\n\nDesenhe o polígono apenas dentro dos limites do município onde o cliente está cadastrado.";
                    alert(msg);
                    return;
                }
                processPolygon(selectedShape);
            });
        });

        google.maps.event.addListener(drawingManager, "overlaycomplete", function (event) {
            google.maps.event.addListener(event.overlay.getPath(), "set_at", () => processPolygon(selectedShape));
            google.maps.event.addListener(event.overlay.getPath(), "insert_at", () => processPolygon(selectedShape));
        });
    }

    // Normaliza texto para comparação (minúsculo, sem acentos)
    function normalizarTexto(str) {
        if (!str) return "";
        return str.toLowerCase().trim()
            .normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    }

    // Obtém o município do endereço retornado pelo geocoder (reverse).
    // No Brasil: locality = cidade/município; administrative_area_level_2 também pode ser o município.
    function obterMunicipioDeAddressComponents(components) {
        var locality = "", admin2 = "";
        for (var i = 0; i < components.length; i++) {
            var types = components[i].types;
            if (types.indexOf("locality") !== -1) locality = components[i].long_name;
            if (types.indexOf("administrative_area_level_2") !== -1) admin2 = components[i].long_name;
        }
        return locality || admin2 || "";
    }

    // Valida se todos os pontos do polígono estão no município da propriedade (reverse geocode com region BR).
    function validarPoligonoNoMunicipio(polygon, callback) {
        var cidadePropriedade = (window.propriedadeCidade || "").trim();
        if (!cidadePropriedade) {
            callback(false, "", "Selecione uma propriedade antes de desenhar o polígono para validar o município.");
            return;
        }

        var path = polygon.getPath();
        var n = path.getLength();
        if (n < 3) {
            callback(false, "", "Polígono inválido.");
            return;
        }

        var totalLat = 0, totalLng = 0;
        path.forEach(function (latLng) {
            totalLat += latLng.lat();
            totalLng += latLng.lng();
        });
        var centerLat = totalLat / n, centerLng = totalLng / n;

        var pontos = [
            new google.maps.LatLng(centerLat, centerLng),
            path.getAt(0),
            path.getAt(Math.min(Math.floor(n / 3), n - 1)),
            path.getAt(Math.min(Math.floor(2 * n / 3), n - 1))
        ];

        var normalizadoProp = normalizarTexto(cidadePropriedade);
        var pendentes = pontos.length;
        var municipiosEncontrados = [];
        var primeiroMunicipioDiferente = "";
        var algumPontoSemMunicipio = false;
        var qtdFalhasGeocode = 0;

        function processarResultado(latLng, results, status) {
            var municipio = "";
            if (status !== google.maps.GeocoderStatus.OK) qtdFalhasGeocode++;
            else if (results && results.length > 0) {
                municipio = obterMunicipioDeAddressComponents(results[0].address_components);
            }
            municipiosEncontrados.push(municipio);
            var norm = normalizarTexto(municipio);
            if (!municipio || !norm) algumPontoSemMunicipio = true;
            else if (normalizadoProp !== norm) primeiroMunicipioDiferente = primeiroMunicipioDiferente || municipio;
            pendentes--;
            if (pendentes === 0) {
                if (qtdFalhasGeocode === pontos.length) {
                    callback(true, "", "");
                    return;
                }
                var algumDentro = municipiosEncontrados.some(function (m) { return normalizarTexto(m) === normalizadoProp; });
                var valido = !algumPontoSemMunicipio && !primeiroMunicipioDiferente && algumDentro;
                var msg = valido ? "" : (algumPontoSemMunicipio ? "Não foi possível verificar o município em todos os pontos. Tente desenhar mais próximo da área da propriedade." : "O polígono está fora do município da propriedade.");
                callback(valido, primeiroMunicipioDiferente || municipiosEncontrados[0] || "", msg);
            }
        }

        pontos.forEach(function (latLng) {
            geocoder.geocode({ location: latLng, region: "br" }, function (results, status) {
                processarResultado(latLng, results, status);
            });
        });
    }

    function processPolygon(polygon) {
        const path = polygon.getPath();
        const bounds = new google.maps.LatLngBounds();
        let totalLat = 0;
        let totalLng = 0;

        path.forEach(latLng => {
            bounds.extend(latLng);
            totalLat += latLng.lat();
            totalLng += latLng.lng();
        });

        // Calcula a área em hectares (usar ponto para o servidor aceitar o decimal)
        const area = google.maps.geometry.spherical.computeArea(path) / 10000;
        areaField.value = area.toFixed(2);

        // Calcula a latitude e longitude médias
        const centerLat = totalLat / path.getLength();
        const centerLng = totalLng / path.getLength();
        latitudeField.value = centerLat.toFixed(6);
        longitudeField.value = centerLng.toFixed(6);

        // Ajusta o mapa para o polígono
        map.fitBounds(bounds);

        // Gera o roteiro de acesso
        generateRoute(centerLat, centerLng);
    }

    // Gera o roteiro de acesso ao polígono
    function generateRoute(lat, lng) {
        const address = addressInput.value.trim();

        if (!address) {
            roteiroAcessoField.value = "Endereço de origem não fornecido.";
            return;
        }

        directionsService.route(
            {
                origin: address,
                destination: { lat, lng },
                travelMode: google.maps.TravelMode.DRIVING,
            },
            function (response, status) {
                if (status === google.maps.DirectionsStatus.OK) {
                    // Processa cada instrução
                    const steps = response.routes[0].legs[0].steps.map(step => {
                        // Remove HTML e adiciona espaço ao final se necessário
                        const instruction = stripHtml(step.instructions);

                        // Garante que instruções consecutivas sejam separadas
                        return instruction.endsWith('.') || instruction.endsWith(',')
                            ? instruction
                            : instruction + '.';
                    });

                    // Junta as instruções com quebra de linha
                    roteiroAcessoField.value = steps.join("\n");
                } else {
                    roteiroAcessoField.value = "Não foi possível gerar o roteiro de acesso.";
                }
            }
        );

        setTimeout(capturarImagemMapa, 1000);
        setTimeout(gerarKmlMapa, 1000);
    }

    function stripHtml(html) {
        const div = document.createElement("div");
        div.innerHTML = html;
        return div.textContent || div.innerText || "";
    }
    // Geocodifica o endereço e centraliza o mapa com zoom no endereço (evita ficar só no Brasil)
    let addressMarker = null; // Variável para armazenar o marcador do endereço
    
    function centralizarNoEndereco() {
        var address = addressInput.value.trim();
        if (!address) {
            alert("Selecione uma propriedade primeiro para centralizar no endereço.");
            return;
        }
        carregarMapa();
    }

    function carregarMapa(enderecoOpcional) {
        var address = (enderecoOpcional && enderecoOpcional.trim()) ? enderecoOpcional.trim() : (addressInput && addressInput.value) ? addressInput.value.trim() : "";
        if (!address) {
            return;
        }
        if (addressInput) addressInput.value = address;

        geocoder.geocode({ address: address, region: "br" }, function (results, status) {
            if (status === google.maps.GeocoderStatus.OK) {
                const result = results[0];
                const location = result.geometry.location;
                
                if (addressMarker) {
                    addressMarker.setMap(null);
                }
                
                addressMarker = new google.maps.Marker({
                    position: location,
                    map: map,
                    title: `Local: ${address}`,
                    icon: {
                        url: 'http://maps.google.com/mapfiles/ms/icons/red-dot.png'
                    }
                });
                
                // Zoom no endereço: priorizar setCenter + setZoom para não ficar no Brasil
                var locationType = result.geometry.location_type || "";
                var zoomLevel = 15; // padrão para endereço
                if (locationType === "ROOFTOP" || locationType === "RANGE_INTERPOLATED") zoomLevel = 17;
                else if (locationType === "GEOMETRIC_CENTER") zoomLevel = 14;
                else if (locationType === "APPROXIMATE") zoomLevel = 13;

                map.setCenter(location);
                map.setZoom(zoomLevel);

                // Se tiver viewport e for pequeno o suficiente, pode usar; senão mantém zoom garantido acima
                if (result.geometry.viewport) {
                    map.fitBounds(result.geometry.viewport);
                    google.maps.event.addListenerOnce(map, "idle", function () {
                        var z = map.getZoom();
                        if (z < 13) {
                            map.setCenter(location);
                            map.setZoom(zoomLevel);
                        } else if (z > 18) {
                            map.setZoom(18);
                        }
                    });
                }
            } else {
                // Modo desenvolvimento: Geocoding API pode não estar ativa; centraliza no Brasil para não quebrar
                console.warn("Geocoding indisponível:", status);
                var centroBrasil = new google.maps.LatLng(-14.235004, -51.92528);
                if (map) {
                    map.setCenter(centroBrasil);
                    map.setZoom(5);
                }
                alert("Em modo de desenvolvimento a centralização pelo endereço não está disponível (ative a Geocoding API no Google Cloud ou use uma chave válida).\n\nO mapa foi centralizado no Brasil. Você pode dar zoom e desenhar o polígono normalmente.");
            }
        });
    }

    function capturarImagemMapa() {
        if (!map) {
            alert("Mapa não está carregado.");
            return;
        }

        if (!selectedShape) {
            alert("Desenhe um polígono antes de capturar a imagem.");
            return;
        }

        // Obtém os limites do polígono
        const bounds = new google.maps.LatLngBounds();
        const path = selectedShape.getPath();

        path.forEach(latLng => {
            bounds.extend(latLng);
        });

        // Adiciona um padding (em graus)
        const paddingDegrees = 0.002; // Ajuste este valor para mais ou menos padding
        const northEast = bounds.getNorthEast();
        const southWest = bounds.getSouthWest();

        const paddedBounds = new google.maps.LatLngBounds(
            new google.maps.LatLng(southWest.lat() - paddingDegrees, southWest.lng() - paddingDegrees),
            new google.maps.LatLng(northEast.lat() + paddingDegrees, northEast.lng() + paddingDegrees)
        );

        map.fitBounds(paddedBounds);

        // Usa html2canvas para capturar a imagem do mapa
        html2canvas(document.getElementById("map"), {
            useCORS: true,
            scale: 2,
        }).then(function (canvas) {
            const image = canvas.toDataURL("image/png");
            mapScreenshot.src = image;
            mapScreenshot.style.display = "block";
            imageJson.value = image;
        }).catch(function (error) {
            console.error("Erro ao capturar a imagem:", error);
        });
    }

    // Gera o KML do polígono desenhado
    function gerarKmlMapa() {
        if (!selectedShape) {
            alert("Desenhe um polígono antes de gerar o KML.");
            return;
        }

        const path = selectedShape.getPath();
        let kml = `<?xml version="1.0" encoding="UTF-8"?>\n`;
        kml += `<kml xmlns="http://www.opengis.net/kml/2.2">\n`;
        kml += `  <Document>\n`;
        kml += `    <Placemark>\n`;
        kml += `      <Polygon>\n`;
        kml += `        <outerBoundaryIs>\n`;
        kml += `          <LinearRing>\n`;
        kml += `            <coordinates>\n`;

        path.forEach(function (latLng) {
            kml += `              ${latLng.lng()},${latLng.lat()},0\n`;
        });

        kml += `            </coordinates>\n`;
        kml += `          </LinearRing>\n`;
        kml += `        </outerBoundaryIs>\n`;
        kml += `      </Polygon>\n`;
        kml += `    </Placemark>\n`;
        kml += `  </Document>\n`;
        kml += `</kml>`;

        kmlOutput.style.display = "block";
        kmlOutput.value = kml;
        kmlJson.value = kml;
    }

    function getImageFormat(base64String) {
        // Verifica se a string começa com "data:image/"
        if (base64String.startsWith("data:image/")) {
            // Divide a string pelo delimitador ";base64,"
            const format = base64String.split(";")[0];
            // Retorna o formato da imagem após "data:image/"
            return format.split("/")[1];
        }
        return null; // Retorna null se não for uma string válida de imagem base64
    }

    function excluir() {
        const tableBody = document.querySelector("#resultGrid tbody");
        for (var i = tableBody.rows.length - 1; i > 0; i--) {
            tableBody.deleteRow(i);
        }

        imageJson.value = '';
        kmlJson.value = '';
        mapScreenshot.value = '';
        kmlOutput.value = '';
    }

    function downloadFiles() {
        if (!imageJson.value || !kmlJson.value) {
            alert("Nenhuma imagem ou KML disponível para download.");
            return;
        }

        // Criar e baixar a imagem
        const imageLink = document.createElement("a");
        imageLink.href = imageJson.value;
        imageLink.download = "map_screenshot.png";
        document.body.appendChild(imageLink);
        imageLink.click();
        document.body.removeChild(imageLink);

        // Criar e baixar o arquivo KML
        const kmlBlob = new Blob([kmlJson.value], { type: "application/vnd.google-earth.kml+xml" });
        const kmlUrl = URL.createObjectURL(kmlBlob);
        const kmlLink = document.createElement("a");
        kmlLink.href = kmlUrl;
        kmlLink.download = "map_polygon.kml";
        document.body.appendChild(kmlLink);
        kmlLink.click();
        document.body.removeChild(kmlLink);

        URL.revokeObjectURL(kmlUrl);
    }

    function removeExistingPolygon() {
        if (selectedShape) {
            selectedShape.setMap(null);
            selectedShape = null;
        }
        if (loadedPolygon) {
            loadedPolygon.setMap(null);
            loadedPolygon = null;
        }
    }

    // Apaga o polígono desenhado e limpa os campos (área, coordenadas, roteiro, imagem e KML)
    function apagarPoligono() {
        removeExistingPolygon();
        if (areaField) areaField.value = "";
        if (latitudeField) latitudeField.value = "";
        if (longitudeField) longitudeField.value = "";
        if (roteiroAcessoField) roteiroAcessoField.value = "";
        if (mapScreenshot) {
            mapScreenshot.src = "";
            mapScreenshot.style.display = "none";
        }
        if (imageJson) imageJson.value = "";
        if (kmlOutput) {
            kmlOutput.value = "";
            kmlOutput.style.display = "none";
        }
        if (kmlJson) kmlJson.value = "";
    }

    function decodeHtmlEntities(encodedString) {
        const textarea = document.createElement("textarea");
        textarea.innerHTML = encodedString;
        return textarea.value;
    }

    // skipMunicipioValidation: true = polígono já desenhado/salvo (não validar município); false = importação nova (validar)
    function loadKmlFromJson(kmlString, skipMunicipioValidation) {
        if (!kmlString) {
            console.error("KML vazio ou não fornecido.");
            return;
        }
        if (typeof skipMunicipioValidation === "undefined") skipMunicipioValidation = false;

        const decodedKml = decodeHtmlEntities(kmlString);
        const parser = new DOMParser();
        const kmlDoc = parser.parseFromString(decodedKml, "text/xml");

        document.getElementById("kmlOutput").value = decodedKml;
        kmlJson.value = decodedKml;

        if (kmlDoc.getElementsByTagName("parsererror").length > 0) {
            console.error("Erro ao parsear o KML.");
            return;
        }

        const coordinatesElement = kmlDoc.querySelector("LinearRing > coordinates");
        if (!coordinatesElement) {
            console.error("Elemento <coordinates> não encontrado.");
            return;
        }

        const coordinatesText = coordinatesElement.textContent.trim();
        const coordinates = coordinatesText.split(/\s+/).map(coord => {
            const [lng, lat] = coord.split(",");
            return new google.maps.LatLng(parseFloat(lat), parseFloat(lng));
        });

        if (coordinates.length > 0) {
            removeExistingPolygon();

            loadedPolygon = new google.maps.Polygon({
                paths: coordinates,
                map: map,
                editable: true,
                draggable: false,
            });

            selectedShape = loadedPolygon;

            function aplicarPolygonCarregado() {
                processPolygon(loadedPolygon);
                const bounds = new google.maps.LatLngBounds();
                coordinates.forEach(coord => bounds.extend(coord));
                map.fitBounds(bounds);
                google.maps.event.addListener(loadedPolygon.getPath(), "set_at", () => processPolygon(loadedPolygon));
                google.maps.event.addListener(loadedPolygon.getPath(), "insert_at", () => processPolygon(loadedPolygon));
            }

            if (skipMunicipioValidation) {
                aplicarPolygonCarregado();
            } else {
                validarPoligonoNoMunicipio(loadedPolygon, function (valido, municipioEncontrado, mensagemErro) {
                    if (!valido) {
                        apagarPoligono();
                        var msg = mensagemErro || "O polígono do KML está fora do município da propriedade.";
                        if (municipioEncontrado) msg += "\n\nMunicípio da propriedade: " + (window.propriedadeCidade || "") + "\nÁrea do KML está em: " + municipioEncontrado;
                        msg += "\n\nImporte um KML dentro dos limites do município.";
                        alert(msg);
                        return;
                    }
                    aplicarPolygonCarregado();
                });
            }
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        initializeMap();
    });
</script>

<script>
