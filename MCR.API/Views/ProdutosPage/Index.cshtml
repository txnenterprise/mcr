@using System.Globalization;
@model MCR.API.Models.ProdutosViewModel
@{
    ViewData["Title"] = "Produtos";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="form-box">
    <h4 class="form-title form-box-title justify-content-center align-items-center">Produtos</h4>
    <br />
    <div class="row">
        <div class="col-md-2">
            <a asp-action="Cadastrar" asp-controller="ProdutosPage" class="btn btn-secondary rounded-pill">
                Cadastrar
            </a>
        </div>
    </div>
    <br />
    <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)">
        <div class="card-body" style="color: var(--color-primary)">
            <h6>Filtros</h6>
            <br />
            <form asp-action="Index" method="get">
                <div class="row">
                    <div class="col-sm-12 col-md-3 col-lg-3">
                        <div class="form-group">
                            <label for="pesquisaSafra">Safra</label>
                            <select class="form-select form-dropdownlist" asp-for="PesquisaSafra">
                                <option value="">Todos</option>
                                @foreach (var safra in ViewData["Safras"] as List<SelectListItem>)
                                {
                                    <option value="@safra.Value">@safra.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-3 col-lg-3">
                        <div class="form-group">
                            <label for="pesquisaCultura">Cultura</label>
                            <select class="form-select form-dropdownlist" asp-for="PesquisaCultura">
                                <option value="">Todos</option>
                                @foreach (var cultura in ViewData["Culturas"] as List<SelectListItem>)
                                {
                                    <option value="@cultura.Value">@cultura.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-3 col-lg-3">
                        <div class="form-group">
                            <label for="pesquisaSeguradora">Seguradora</label>
                            <select class="form-select form-dropdownlist" asp-for="PesquisaSeguradora">
                                <option value="">Todos</option>
                                @foreach (var seguradora in ViewData["Seguradoras"] as List<SelectListItem>)
                                {
                                    <option value="@seguradora.Value">@seguradora.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-3 col-lg-3">
                        <div class="form-group">
                            <label for="pesquisaAtivoInativo">Status</label>
                            <select class="form-select form-dropdownlist" asp-for="PesquisaAtivoInativo">
                                <option value="Todos">Todos</option>
                                <option value="Ativo">Ativo</option>
                                <option value="Inativo">Inativo</option>
                            </select>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <br />
                        <button type="submit" class="btn btn-primary">Filtrar</button>
                        <a href="@Url.Action("Index", "Produtos")" class="btn btn-secondary">Limpar Filtros</a>
                    </div>
                </div>
            </form>

        </div>
    </div>
    <div style="">
        <table id="tblProdutos" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Safra</th>
                    <th>Cultura</th>
                    <th>Seguradora</th>
                    <th>Nome do Produto</th>
                    <th>Modalidade</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.ListaProdutos != null && Model.ListaProdutos.Count > 0)
                {
                    foreach (var item in Model.ListaProdutos)
                    {
                        <tr>
                            <td>@item.SafraAno</td>
                            <td>@item.CulturaNome</td>
                            <td>@item.SeguradoraNome</td>
                            <td>@item.NomeProduto</td>
                            <td>@item.Modalidade</td>
                            @if (item.Ativo == true)
                            {
                                <td><span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Ativo</span></td>
                            }
                            else
                            {
                                <td><span class="badge bg-danger"><i class="bi bi-exclamation-octagon me-1"></i> Inativo</span></td>
                            }
                            <td style="width: 150px;">
                                <div class="dropdown d-inline-block">
                                    <button type="button" class="btn btn-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        Ações
                                    </button>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item" asp-action="Gerenciar" asp-route-id="@item.Id">
                                            <i class="bi bi-gear mr-2"></i> Gerenciar
                                        </a>
                                        <button type="button" class="dropdown-item" data-id="@item.Id" onclick="produtosJS.duplicarProduto('@item.Id')">
                                            <i class="bi bi-copy mr-2"></i> Duplicar
                                        </button>
                                        <button type="button" class="dropdown-item" data-id="@item.Id" data-ativo="@item.Ativo.ToString().ToLower()" onclick="produtosJS.toggleAtivoProduto('@item.Id', '@item.Ativo.ToString().ToLower()')">
                                            <i class="bi bi-power mr-2"></i> @(item.Ativo == true ? "Inativar" : "Ativar")
                                        </button>
                                        <div class="dropdown-divider"></div>
                                        <button type="button" class="dropdown-item text-danger" data-id="@item.Id" onclick="produtosJS.excluirProduto('@item.Id')">
                                            <i class="bi bi-trash mr-2"></i> Excluir
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div style="overflow-x:auto;">
        <nav aria-label="Page navigation">
            <ul class="pagination">
                @if (Model.PaginaAtual > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.PaginaAtual - 1)"
                           asp-route-pesquisaAtivoInativo="@Model.PesquisaAtivoInativo"
                           asp-route-pesquisaSafra="@Model.PesquisaSafra"
                           asp-route-pesquisaCultura="@Model.PesquisaCultura"
                           asp-route-pesquisaSeguradora="@Model.PesquisaSeguradora">Anterior</a>
                    </li>
                }
                @for (var i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaAtual ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@i"
                           asp-route-pesquisaAtivoInativo="@Model.PesquisaAtivoInativo"
                           asp-route-pesquisaSafra="@Model.PesquisaSafra"
                           asp-route-pesquisaCultura="@Model.PesquisaCultura"
                           asp-route-pesquisaSeguradora="@Model.PesquisaSeguradora">@i</a>
                    </li>
                }
                @if (Model.PaginaAtual < Model.TotalPaginas)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.PaginaAtual + 1)"
                           asp-route-pesquisaAtivoInativo="@Model.PesquisaAtivoInativo"
                           asp-route-pesquisaSafra="@Model.PesquisaSafra"
                           asp-route-pesquisaCultura="@Model.PesquisaCultura"
                           asp-route-pesquisaSeguradora="@Model.PesquisaSeguradora">Próximo</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

@section Scripts {
    <script src="~/app/produtos/produtos.js"></script>
}
