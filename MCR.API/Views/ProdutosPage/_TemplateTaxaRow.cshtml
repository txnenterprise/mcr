@model MCR.API.Models.ProdutosViewModel
<!-- Template para nova linha de taxa -->
<template id="taxaRowTemplate">
    <div class="taxa-row border p-2 mb-2">
        <input type="hidden" name="Produto.Taxas[__INDEX__].Id" value="" />
        <input type="hidden" name="Produto.Taxas[__INDEX__].ProdutoId" value="@Model.Produto.Id" />
        <div class="row mb-2">
            <!-- UF: dropdown fixo -->
            <div class="col-md-3">
                <div class="form-floating">
                    <select class="form-select taxa-uf" name="Produto.Taxas[__INDEX__].UF">
                        <option value="">Selecione um Estado</option>
                        <option value="AC">Acre (AC)</option>
                        <option value="AL">Alagoas (AL)</option>
                        <option value="AP">Amapá (AP)</option>
                        <option value="AM">Amazonas (AM)</option>
                        <option value="BA">Bahia (BA)</option>
                        <option value="CE">Ceará (CE)</option>
                        <option value="DF">Distrito Federal (DF)</option>
                        <option value="ES">Espírito Santo (ES)</option>
                        <option value="GO">Goiás (GO)</option>
                        <option value="MA">Maranhão (MA)</option>
                        <option value="MT">Mato Grosso (MT)</option>
                        <option value="MS">Mato Grosso do Sul (MS)</option>
                        <option value="MG">Minas Gerais (MG)</option>
                        <option value="PA">Pará (PA)</option>
                        <option value="PB">Paraíba (PB)</option>
                        <option value="PR">Paraná (PR)</option>
                        <option value="PE">Pernambuco (PE)</option>
                        <option value="PI">Piauí (PI)</option>
                        <option value="RJ">Rio de Janeiro (RJ)</option>
                        <option value="RN">Rio Grande do Norte (RN)</option>
                        <option value="RS">Rio Grande do Sul (RS)</option>
                        <option value="RO">Rondônia (RO)</option>
                        <option value="RR">Roraima (RR)</option>
                        <option value="SC">Santa Catarina (SC)</option>
                        <option value="SP">São Paulo (SP)</option>
                        <option value="SE">Sergipe (SE)</option>
                        <option value="TO">Tocantins (TO)</option>
                    </select>
                    <label>UF</label>
                </div>
            </div>
            <!-- Município: -->
            <div class="col-md-3">
                <div class="form-floating">
                    <select class="form-select taxa-municipio" name="Produto.Taxas[__INDEX__].Municipio">
                        <option value="">Selecione um Município</option>
                    </select>
                    <label>Município</label>
                </div>
            </div>
            <!-- Produtividade Esperada -->
            <div class="col-md-3">
                <div class="form-floating">
                    <input type="number" class="form-control taxa-produtividade currency" name="Produto.Taxas[__INDEX__].ProdutividadeEsperada" placeholder="Produtividade Esperada Kg/HÁ" />
                    <label>Produtividade Esperada Kg/HÁ</label>
                </div>
            </div>
            <!-- Taxa NC65 -->
            <div class="col-md-3">
                <div class="form-floating">
                    <input type="number" step="0.0001" class="form-control taxa-taxaNc65 taxamask" name="Produto.Taxas[__INDEX__].TaxaNc65" placeholder="Taxa NC 65%" />
                    <label>Taxa NC 65%</label>
                </div>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-md-3">
                <div class="form-floating">
                    <input type="number" step="0.0001" class="form-control taxa-taxaNc70 taxamask" name="Produto.Taxas[__INDEX__].TaxaNc70" placeholder="Taxa NC 70%" />
                    <label>Taxa NC 70%</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-floating">
                    <input type="number" step="0.0001" class="form-control taxa-taxaNc75 taxamask" name="Produto.Taxas[__INDEX__].TaxaNc75" placeholder="Taxa NC 75%" />
                    <label>Taxa NC 75%</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-floating">
                    <input type="text" class="form-control taxa-cpf" name="Produto.Taxas[__INDEX__].Cpf" placeholder="CPF" />
                    <label>CPF</label>
                </div>
            </div>
        </div>
    </div>
</template>


<script type="text/template" id="canalTemplate" style="display: none;">
    <div class="channel-block border p-2 mb-2" data-index="__INDEX__">
        <div class="row mb-2">
            <div class="col-md-6">
                <div class="form-floating">
                    <select name="Produto.CanalSelections[__INDEX__].CanalId" class="form-select canal-dropdown">
                        <option value="" selected disabled hidden>Selecione um Canal</option>
                        @foreach (SelectListItem canal in Model.CanalOptions)
                        {
                            <option value="@canal.Value">@canal.Text</option>
                        }
                    </select>
                    <label>Canal</label>
                    <span asp-validation-for="Produto.CanalSelections[__INDEX__].CanalId" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6 d-flex align-items-center">
                <button type="button" class="btn btn-danger btn-sm removeChannelBtn">Remover Canal</button>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <label><strong>Pontos de Atendimento</strong></label>
                <div class="pontoAtendimentoContainer">
                    <!-- Os checkboxes serão carregados via AJAX -->
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               name="Produto.CanalSelections[__INDEX__].PontosAtendimentoIds"
                               value="ITEM_ID" id="ponto___INDEX___ITEM_ID" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</script>