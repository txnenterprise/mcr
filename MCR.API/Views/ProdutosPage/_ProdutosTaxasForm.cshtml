<div class="row">
    @if (Model.Produto.Id != Guid.Empty)
    {
        <div class="col-md-6 text-left p-4">
            <button type="submit" class="btn btn-success">Atualizar</button>
        </div>

        <div class="col-md-6 text-right p-4">
            <button type="button" class="btn btn-primary" data-id="@Model?.Produto?.Id" id="btDuplicar">Duplicar Produto</button>
            <button type="button" class="btn btn-warning" data-id="@Model?.Produto?.Id" data-ativo="@Model?.Produto?.Ativo" id="btToggleAtivo">@(Model?.Produto?.Ativo == true ? "Inativar" : "Ativar") Produto</button>
            <button type="button" class="btn btn-danger" data-id="@Model?.Produto?.Id" id="btDelete">Excluir Produto</button>
        </div>
    }
    else
    {
        <div class="col-md-6 text-left p-4">
            <button type="submit" class="btn btn-success">Salvar</button>
        </div>
    }
</div>

