@model MCR.API.Propostas.Domain.DTO.PropostasVistoriaDTO

<div class="card pt-3">
    <div class="card-header text-white">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Vistoria</h5>
        </div>
    </div>

    <div class="card-body">
        @if (Model == null || Model.PessoasVistoria == null || !Model.PessoasVistoria.Any())
        {
            <div class="text-center py-5">
                <p class="text-muted mb-3">Nenhuma pessoa vinculada para acompanhar na vistoria.</p>
                <button type="button" class="btn btn-primary" onclick="propostaJS.openVistoria()" proposal-status-permission="@ViewBag.PropostaStatus">
                    <i class="fas fa-plus me-2"></i> Adicionar
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>CPF</th>
                            <th>Telefone</th>
                            <th class="text-center" proposal-status-permission="@ViewBag.PropostaStatus">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pessoa in Model.PessoasVistoria)
                        {
                            <tr>
                                <td>@pessoa.Nome</td>
                                <td>@pessoa.CPF</td>
                                <td>@pessoa.Telefone</td>
                                <td class="text-center" proposal-status-permission="@ViewBag.PropostaStatus">
                                    <button type="button"
                                            class="btn btn-sm btn-danger vistoriaRemover" data-vistoria="@pessoa.Id" data-nome="@pessoa.Nome">
                                        Remover
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
