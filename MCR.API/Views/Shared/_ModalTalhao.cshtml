<!-- Scripts para funcionalidade de importar KML no modal -->
<script>
    let modalImportedKmlContent = "";

    function handleModalKmlFileUpload(event) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(e) {
            modalImportedKmlContent = e.target.result;
        };
        reader.readAsText(file);
    }

    function importModalKmlFromFile() {
        if (!modalImportedKmlContent) {
            alert("Selecione um arquivo KML primeiro.");
            return;
        }
        loadModalKmlFromJson(modalImportedKmlContent);
    }

    function clearModalImportedKml() {
        modalImportedKmlContent = "";
        document.getElementById("modalKmlFileInput").value = "";
        removeModalExistingPolygon();
        document.getElementById("modalKmlOutput").value = "";
    }

    function removeModalExistingPolygon() {
        // Verificar se as variáveis existem no escopo global ou no objeto clienteJS
        if (typeof modalSelectedShape !== 'undefined' && modalSelectedShape) {
            modalSelectedShape.setMap(null);
            modalSelectedShape = null;
        }
        if (typeof modalLoadedPolygon !== 'undefined' && modalLoadedPolygon) {
            modalLoadedPolygon.setMap(null);
            modalLoadedPolygon = null;
        }
        // Também verificar no objeto clienteJS se existir
        if (typeof clienteJS !== 'undefined' && clienteJS.modalSelectedShape) {
            clienteJS.modalSelectedShape.setMap(null);
            clienteJS.modalSelectedShape = null;
        }
        if (typeof clienteJS !== 'undefined' && clienteJS.modalLoadedPolygon) {
            clienteJS.modalLoadedPolygon.setMap(null);
            clienteJS.modalLoadedPolygon = null;
        }
    }

    function decodeModalHtmlEntities(encodedString) {
        const textarea = document.createElement("textarea");
        textarea.innerHTML = encodedString;
        return textarea.value;
    }

    function loadModalKmlFromJson(kmlString) {
        if (!kmlString) {
            console.error("KML vazio ou não fornecido.");
            return;
        }

        const decodedKml = decodeModalHtmlEntities(kmlString);
        const parser = new DOMParser();
        const kmlDoc = parser.parseFromString(decodedKml, "text/xml");

        document.getElementById("modalKmlOutput").value = decodedKml;

        if (kmlDoc.getElementsByTagName("parsererror").length > 0) {
            console.error("Erro ao parsear o KML.");
            return;
        }

        const coordinatesElement = kmlDoc.querySelector("LinearRing > coordinates");
        if (!coordinatesElement) {
            console.error("Elemento <coordinates> não encontrado.");
            return;
        }

        const coordinatesText = coordinatesElement.textContent.trim();
        const coordinates = coordinatesText.split(/\s+/).map(coord => {
            const [lng, lat] = coord.split(",");
            return new google.maps.LatLng(parseFloat(lat), parseFloat(lng));
        });

        if (coordinates.length > 0) {
            removeModalExistingPolygon(); // Remove qualquer polígono existente antes de carregar um novo

            // Determinar qual mapa usar baseado no contexto
            let targetMap = null;
            
            // Primeiro, verificar se existe uma variável global modalMap
            if (typeof modalMap !== 'undefined' && modalMap && typeof modalMap.fitBounds === 'function') {
                targetMap = modalMap;
            } 
            // Segundo, verificar se existe no objeto clienteJS
            else if (typeof clienteJS !== 'undefined' && clienteJS.modalMap && typeof clienteJS.modalMap.fitBounds === 'function') {
                targetMap = clienteJS.modalMap;
            }
            // Terceiro, tentar obter o mapa do elemento DOM
            else {
                const mapElement = document.getElementById("modalMap");
                if (mapElement && mapElement._googleMap) {
                    targetMap = mapElement._googleMap;
                }
            }

            if (!targetMap || typeof targetMap.fitBounds !== 'function') {
                console.error("Mapa do modal não encontrado ou inválido. TargetMap:", targetMap);
                alert("Erro: Mapa não está inicializado. Tente fechar e abrir o modal novamente.");
                return;
            }

            // Criar o polígono
            const newPolygon = new google.maps.Polygon({
                paths: coordinates,
                map: targetMap,
                editable: true,
                draggable: false,
            });

            // Atribuir o polígono à variável correta baseado no contexto
            if (typeof modalSelectedShape !== 'undefined') {
                modalSelectedShape = newPolygon;
            } else if (typeof clienteJS !== 'undefined') {
                clienteJS.modalSelectedShape = newPolygon;
            }

            if (typeof modalLoadedPolygon !== 'undefined') {
                modalLoadedPolygon = newPolygon;
            } else if (typeof clienteJS !== 'undefined') {
                clienteJS.modalLoadedPolygon = newPolygon;
            }

            // Processar o polígono para calcular área, coordenadas e roteiro
            if (typeof processModalPolygon !== 'undefined') {
                processModalPolygon(newPolygon);
            } else if (typeof clienteJS !== 'undefined' && clienteJS.processModalPolygon) {
                clienteJS.processModalPolygon(newPolygon);
            }

            // Ajustar o mapa para mostrar o polígono
            try {
                const bounds = new google.maps.LatLngBounds();
                coordinates.forEach(coord => bounds.extend(coord));
                targetMap.fitBounds(bounds);
            } catch (error) {
                console.error("Erro ao ajustar mapa:", error);
            }

            // Adicionar listeners para edição do polígono
            google.maps.event.addListener(newPolygon.getPath(), "set_at", () => {
                if (typeof processModalPolygon !== 'undefined') {
                    processModalPolygon(newPolygon);
                } else if (typeof clienteJS !== 'undefined' && clienteJS.processModalPolygon) {
                    clienteJS.processModalPolygon(newPolygon);
                }
            });
            google.maps.event.addListener(newPolygon.getPath(), "insert_at", () => {
                if (typeof processModalPolygon !== 'undefined') {
                    processModalPolygon(newPolygon);
                } else if (typeof clienteJS !== 'undefined' && clienteJS.processModalPolygon) {
                    clienteJS.processModalPolygon(newPolygon);
                }
            });
        }
    }
</script> 