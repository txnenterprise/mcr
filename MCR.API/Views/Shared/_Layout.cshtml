@using System.Security.Claims
@using System.Linq
@using Microsoft.AspNetCore.Identity

@inject UserManager<UsuarioEntity> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
    var role = user != null ? await UserManager.GetRolesAsync(user) : new List<string>();
    string currentUrl = Context.Request.Path;
    if (!currentUrl.Equals(Url.Action("Authentication", "Login"), StringComparison.OrdinalIgnoreCase) &&
    !currentUrl.Equals(Url.Action("LogOff", "Login"), StringComparison.OrdinalIgnoreCase) &&
    !currentUrl.Equals(Url.Action("ForgotPassword", "Login"), StringComparison.OrdinalIgnoreCase) &&
    !currentUrl.Equals(Url.Action("CheckEmail", "Login"), StringComparison.OrdinalIgnoreCase) &&
    !currentUrl.Equals(Url.Action("ResetPassword", "Login"), StringComparison.OrdinalIgnoreCase) &&
    !currentUrl.Equals(Url.Action("ResetPasswordConfirmation", "Login"), StringComparison.OrdinalIgnoreCase) &&
    !currentUrl.Equals(Url.Action("AccessDenied", "Login"), StringComparison.OrdinalIgnoreCase))
    {
        if (!User.Identity.IsAuthenticated)
        {
            string loginUrl = Url.Action("Authentication", "Login");
            <script>window.location.href = '@loginUrl';</script>
        }
    }
}
<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Multi-Cálculo</title>
