<body>
    @if (User.Identity.IsAuthenticated)
    {

        <!-- ======= Header ======= -->
        <header id="header" class="header fixed-top d-flex align-items-center">

            @await Component.InvokeAsync("LayoutLogo")

            <nav class="header-nav ms-auto">
                <ul class="d-flex align-items-center">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item me-3">
                            <a asp-controller="CotacaoAgricola" asp-action="Cadastrar"
                               class="btn btn-success btn-sm rounded-pill d-flex align-items-center gap-1"
                               style="font-weight: 600; white-space: nowrap;">
                                <i class="bi bi-plus-lg"></i> Nova Cotação
                            </a>
                        </li>
                    }
                    <li class="nav-item dropdown pe-3">
                        <a class="nav-link nav-profile d-flex align-items-center pe-0" asp-controller="Home"
                           asp-action="Index" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i>
                            <span class="d-none d-md-block dropdown-toggle ps-2">@(user?.Name ?? "Usuário")</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">
                            <li class="dropdown-header">
                                <h6>@(user?.Name ?? "Usuário")</h6>
                                <p>@(user?.Email ?? "")</p>
                                <p>@role.FirstOrDefault()</p>
                            </li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center" asp-controller="Login"
                                   asp-action="Logoff">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Sair</span>
                                </a>
                            </li>

                        </ul><!-- End Profile Dropdown Items -->
                    </li><!-- End Profile Nav -->

                </ul>
            </nav><!-- End Icons Navigation -->

        </header>

        <!-- End Header -->
        <!-- ======= Sidebar ======= -->
        <aside id="sidebar" class="sidebar">
            <ul class="sidebar-nav" id="sidebar-nav">

                <li class="nav-item">
                    <a class="nav-link " asp-controller="Dashboard"
                       asp-action="Index">
                        <i class="bi bi-grid"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
