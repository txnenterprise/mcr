    <!-- Script de configuração validação de decimais -->
    <script>
        $(document).ready(function () {
            // Verifica se o jQuery Validate está disponível
            if (typeof $.validator !== 'undefined' && $.validator && $.validator.methods) {
                // Configurar o jQuery Validate para aceitar vírgula como separador decimal
                $.validator.methods.number = function (value, element) {
                    return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:[\s\.,]\d{3})+)(?:[\.,]\d+)?$/.test(value);
                };

                // Configurar o jQuery Validate para analisar corretamente números decimais com vírgula
                $.validator.methods.range = function (value, element, param) {
                    var normalizedValue = value.replace(",", ".");
                    return this.optional(element) || (normalizedValue >= param[0] && normalizedValue <= param[1]);
                };
            } else {
                console.warn("jQuery Validate não está carregado corretamente");
            }
        });
    </script>

       <!-- Scripts adicionais da seção -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
