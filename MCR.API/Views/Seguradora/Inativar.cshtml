@model MCR.API.Models.ViewModels.SeguradoraModel
@{
    if (Model.Seguradora.Ativo)
        ViewData["Title"] = "Seguradoras - Inativar";
    else
        ViewData["Title"] = "Seguradoras - Ativar";
}
<div class="form-box">
    @if (Model.Seguradora.Ativo)
    {
        <h4 class="form-title form-box-title justify-content-center align-items-center">Seguradoras - Inativar</h4>
    }
    else
    {
        <h4 class="form-title form-box-title justify-content-center align-items-center">Seguradoras - Ativar</h4>
    }
    <br /><br />
    <div class="row">
        <div class="col-md-2">
            <a asp-action="Index" asp-controller="Seguradora" class="btn btn-secondary rounded-pill">
                Voltar
            </a>
        </div>
    </div>
    <br /><br />
    <div class="row">
        <div class="col-sm-12 col-md-6 col-lg-6">
            <form asp-controller="Seguradora" method="post" id="inativarSeguradora">
                <div class="mb-3">
                    <img id="previewImage" class="img-thumbnail img-fluid" alt="Logo" width="200">
                </div>
                <ul class="list-group">
                    <li class="list-group-item">Razão Social: @Model.Seguradora.RazaoSocial</li>
                    <li class="list-group-item">Nome Fantasia: @Model.Seguradora.NomeFantasia</li>
                    <li class="list-group-item">Ativo? @(Model.Seguradora.Ativo ? "Sim" : "Não")</li>
                </ul>
                <input type="hidden" id="Logo" name="Seguradora.Logo" asp-for="Seguradora.Logo" />
                <input asp-for="Seguradora.Id" value="@Model.Seguradora.Id" hidden>
                <br />
                <br />
                @if (Model.Seguradora.Ativo)
                {
                    <div class="alert alert-warning" role="alert">
                        <h6>Deseja, realmente, inativar este cadastro?</h6>
                    </div>
                    <br />
                    <div class="social-login">
                        <button type="submit" action="Inativar" class="login-btn btn d-flex justify-content-center align-items-center" onclick="setAction('Inativar')">
                            Inativar
                        </button>
                    </div>
                }
                else
                {
                    <div class="social-login">
                        <button type="submit" class="login-btn btn d-flex justify-content-center align-items-center" onclick="setAction('Ativar')">
                            Ativar
                        </button>
                    </div>
                }
            </form>
            @if (Model != null && !Model.Seguradora.Sucesso)
            {
                <br />
                <div class="alert alert-warning text-center" role="alert" style="color: #b59900; border-radius: 15px">
                    <h6>Atenção!</h6>
                    <h6>@Model.Seguradora.Mensagem</h6>
                </div>
            }
        </div>
    </div>
</div>
<script>
    function setAction(action) {
        var id = document.getElementById("Seguradora_Id").value;
        document.getElementById("inativarSeguradora").action = '/Seguradora/' + action + '/' + id;
    }

    const previewImage = document.getElementById('previewImage');
    const logo = document.getElementById('Logo');
    if (logo.value) {
        previewImage.src = 'data:image/jpeg;base64,' + logo.value;
    }

</script>