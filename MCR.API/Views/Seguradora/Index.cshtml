@using System.Collections.Generic
@model MCR.API.Models.SeguradoraModel
@{
    ViewData["Title"] = "Seguradoras";
}
<div class="form-box">
    <h4 class="form-title form-box-title justify-content-center align-items-center">Seguradoras</h4>
    <br /><br />
    <div class="row">
        <div class="col-md-2">
            <a asp-action="Cadastrar" asp-controller="Seguradora" class="btn btn-secondary rounded-pill">
                Cadastrar
            </a>
        </div>
    </div>
    <br /><br />
    <div style="overflow-x:auto;">
        <table id="table-grid" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Razão Social</th>
                    <th>Nome Fantasia</th>
                    <th>Ativo?</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ListaSeguradoras != null && Model.ListaSeguradoras.Count > 0)
                {
                    foreach (var item in Model.ListaSeguradoras)
                    {
                        <tr>
                            <td>@item.RazaoSocial</td>
                            <td>@item.NomeFantasia</td>
                            <td>@(item.Ativo ? "Sim" : "Não")</td>
                            <td>
                                @if (item.Ativo)
                                {
                                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Editar</a>
                                    <form asp-action="Inativar" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-warning btn-sm">Inativar</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Ativar" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-dark btn-sm">Ativar</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>
</div>
