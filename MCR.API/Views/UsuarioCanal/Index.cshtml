@using System.Globalization;
@model MCR.API.Models.ViewModels.UsuarioCanalModel
@{
    ViewData["Title"] = "Usuário - Canal";
}
<div class="form-box">
    <h4 class="form-title form-box-title justify-content-center align-items-center">Usuário - Canal</h4>
    <br />
    <div class="row">
        <div class="col-md-2">
            <a asp-action="Cadastrar" asp-controller="UsuarioCanal" class="btn btn-secondary rounded-pill">
                Cadastrar
            </a>
        </div>
    </div>
    <br />
    <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)">
        <div class="card-body" style="color: var(--color-primary)">
            <h6>Filtros</h6>
            <br />
            <form asp-action="Index" method="get">
                <div class="row">
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <div class="form-group">
                            <label for="dataHoraCotacaoInicio">Nome do Usuário</label>
                            <input type="text" class="form-control"
                                   asp-for="PesquisaNomeUsuario"
                                   value="@Model.PesquisaNomeUsuario" />
                        </div>
                    </div>
                    <br />
                    <div class="col-sm-12 col-md-3 col-lg-3">
                        <div class="form-group">
                            <label for="dataHoraCotacaoInicio">Nome do Liderado</label>
                            <input type="text" class="form-control"
                                   asp-for="PesquisaNomeLiderado"
                                   value="@Model.PesquisaNomeLiderado" />
                        </div>
                    </div>
                    <br />
                    <div class="col-sm-12 col-md-3 col-lg-3">
                        <div class="form-group">
                            <label for="dataHoraCotacaoInicio">Nome do Canal</label>
                            <input type="text" class="form-control"
                                   asp-for="PesquisaNomeCanal"
                                   value="@Model.PesquisaNomeCanal" />
                        </div>
                    </div>
                    <br />
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <br />
                        <button type="submit" class="btn btn-primary">Filtrar</button>
                    </div>
                    <br />
                </div>
            </form>
        </div>
    </div>
    <br />
    <div style="overflow-x:auto;">
        <table id="tblCadastro" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Usuário</th>
                    <th>Liderado</th>
                    <th>Canal</th>
                    <th>Excluído?</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.ListaUsuarioCanal != null && Model.ListaUsuarioCanal.Count > 0 && Model.ListaUsuarioCanal[0].Sucesso)
                {
                    foreach (var item in Model.ListaUsuarioCanal)
                    {
                        <tr>
                            <td>@(item.Usuario?.Name ?? "N/A")</td>
                            <td>@(item.UsuarioLiderado?.Name ?? "N/A")</td>
                            <td>@(item.Canal?.RazaoSocial ?? "N/A")</td>
                            <td>
                                @if (item.Excluido)
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-check-trash me-1"></i> Sim
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i> Não
                                    </span>
                                }
                            </td>
                            <td>
                                @if (item.Excluido)
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-trash me-1"></i> Vínculo Excluído
                                    </span>
                                }
                                else
                                {
                                    <a asp-action="Gerenciar" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                        Excluir
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">Nenhum registro encontrado.</td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

    <div style="overflow-x:auto;">
        <nav aria-label="Page navigation">
            <ul class="pagination">
                @if (Model.PaginaAtual > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index"
                           asp-route-pagina="@(Model.PaginaAtual - 1)"
                           asp-route-pesquisaNomeUsuario="@Model.PesquisaNomeUsuario"
                           asp-route-pesquisaNomeLiderado="@Model.PesquisaNomeLiderado"
                           asp-route-pesquisaNomeCanal="@Model.PesquisaNomeCanal">Anterior</a>
                    </li>
                }

                @for (var i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaAtual ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-pagina="@i"
                           asp-route-pesquisaNomeUsuario="@Model.PesquisaNomeUsuario"
                           asp-route-pesquisaNomeLiderado="@Model.PesquisaNomeLiderado"
                           asp-route-pesquisaNomeCanal="@Model.PesquisaNomeCanal">@i</a>
                    </li>
                }

                @if (Model.PaginaAtual < Model.TotalPaginas)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index"
                           asp-route-pagina="@(Model.PaginaAtual + 1)"
                           asp-route-pesquisaNomeUsuario="@Model.PesquisaNomeUsuario"
                           asp-route-pesquisaNomeLiderado="@Model.PesquisaNomeLiderado"
                           asp-route-pesquisaNomeCanal="@Model.PesquisaNomeCanal">Próximo</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
