                                @if (Model != null && Model.ListaCotacaoRetornoSeguradora != null && Model.ListaCotacaoRetornoSeguradora.Count > 0)
                                {
                                    <h2>@Model.ListaCotacaoRetornoSeguradora.Count</h2>
                                }
                                else
                                {
                                    <h2>0</h2>
                                }
                                <p class="count-text ">Cotações Realizadas</p>
                            </div>
                        </div>
                        <div class="col">
                            <div class="counter">
