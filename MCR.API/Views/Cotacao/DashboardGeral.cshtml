@using System.Globalization;

@model MCR.API.Entities.CotacaoEntity
@{
    ViewData["Title"] = "Dashboard Geral";
}
<div class="form-box">
    <h4 class="form-title form-box-title justify-content-center align-items-center">Dashboard Geral</h4>
    <br /><br />
    <div class="row">
        <div class="col-md-2">
            <a asp-action="Index" asp-controller="Cotacao" class="default-btn btn d-flex justify-content-center align-items-center">
                Voltar
            </a>
        </div>
    </div>
    <br /><br />
    <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)">
        <div class="card-body" style="color: var(--color-primary)">
            <h6>Filtros</h6>
            <br />
            <form asp-action="DashboardGeral" method="get">
                <div class="row">
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <div class="form-group">
                            <label for="dataHoraCotacaoInicio">Data Início:</label>
                            <input type="date" id="dataHoraCotacaoInicio" name="dataHoraCotacaoInicio" class="form-control" value="@Model?.DataHoraCotacaoInicio?.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <br />
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <div class="form-group">
                            <label for="dataHoraCotacaoFim">Data Fim:</label>
                            <input type="date" id="dataHoraCotacaoFim" name="dataHoraCotacaoFim" class="form-control" value="@Model?.DataHoraCotacaoInicio?.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <br />
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <br />
                        <button type="submit" class="btn btn-primary">Filtrar</button>
                    </div>
                    <br />
                </div>
            </form>
        </div>
    </div>
    <br />
    <div class="row">
        <br />
        <div class="col text-center">
            <h2>Demonstrativo de Cotações</h2>
            <p>Análise sintética de cotações realizadas</p>
        </div>
    </div>
    <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)">
        <div class="card-body" style="color: var(--color-primary)">
            <div class="row">
                <div class="container">
                    <div class="row text-center">
                        <div class="col">
                            <div class="counter">
