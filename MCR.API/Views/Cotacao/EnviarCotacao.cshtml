<script>
    function adicionarTermometroCores() {
        var tabela = document.getElementById('tabelaRetornoCotacoes').getElementsByTagName('tbody')[0];
        var linhas = tabela.rows;

        // Encontrar o menor e maior prêmio
        var menorPremio = Number.MAX_VALUE;
        var maiorPremio = Number.MIN_VALUE;

        cotacoesArray.forEach(function (cotacao) {
            var preco = parseFloat(cotacao.premio.replace('R$', '').replace('.', '').replace(',', '.'));
            if (preco < menorPremio) {
                menorPremio = preco;
            }
            if (preco > maiorPremio) {
                maiorPremio = preco;
            }
        });

        var rangePremio = maiorPremio - menorPremio;

        for (var i = 0; i < linhas.length; i++) {
            var preco = parseFloat(linhas[i].cells[2].innerText.replace('R$', '').replace('.', '').replace(',', '.'));

            // Calcular a cor com base na posição relativa do prêmio no intervalo
            var percentual = (preco - menorPremio) / rangePremio;

            // Definir a cor com base no percentual
            var red, green, blue;
            if (percentual <= 0) {
                // Menor prêmio (Verde Escuro)
                red = 0;
                green = 128;
                blue = 0;
            } else if (percentual <= 0.25) {
                // Verde para Amarelo Claro
                red = 122 + Math.round(percentual * 400);
                green = 190 + Math.round(percentual * 62);
                blue = 122;
            } else if (percentual <= 0.5) {
                // Amarelo Claro para Laranja Claro
                red = 255;
                green = 252 - Math.round((percentual - 0.25) * 100);
                blue = 0;
            } else if (percentual <= 0.75) {
                // Laranja Claro para Laranja Escuro
                red = 255;
                green = 152 - Math.round((percentual - 0.5) * 200);
                blue = 0;
            } else {
                // Laranja Escuro para Vermelho Escuro
                red = 255;
                green = 0;
                blue = 0;
            }

            var cor = 'rgb(' + red + ',' + green + ',' + blue + ')';
            linhas[i].style.backgroundColor = cor;
        }
    }

</script>

<script>
    let timers = {};
    let intervalId;
    let totalMinutes = 0;
    let totalSeconds = 0;
    let totalInterval;
    let cotacoesConcluidas = {
        mapfre: false,
        swissre: false,
        allianz: false,
        tokio: false,
        sompo: false,
        pottencial: false,
        sombrero: false,
        fairfax: false
    };

    var cotacoesArray = [];
    var cotacaoConcluida = false;

    if (@Model.ParametrizacaoMultiCalculoParceiro.HabilitarMapfre.ToString().ToLower() == 'false')
        mapfre = true;

    if (@Model.ParametrizacaoMultiCalculoParceiro.HabilitarSwissRe.ToString().ToLower() == 'false')
        swissre = true;

    if (@Model.ParametrizacaoMultiCalculoParceiro.HabilitarAllianz.ToString().ToLower() == 'false')
        allianz = true;

    if (@Model.ParametrizacaoMultiCalculoParceiro.HabilitarTokio.ToString().ToLower() == 'false')
        tokio = true;

    if (@Model.ParametrizacaoMultiCalculoParceiro.HabilitarSompo.ToString().ToLower() == 'false')
        sompo = true;

    if (@Model.ParametrizacaoMultiCalculoParceiro.HabilitarPottencial.ToString().ToLower() == 'false')
        pottencial = true;

    if (@Model.ParametrizacaoMultiCalculoParceiro.HabilitarSombrero.ToString().ToLower() == 'false')
        sombrero = true;

    if (@Model.ParametrizacaoMultiCalculoParceiro.HabilitarFairFax.ToString().ToLower() == 'false')
        fairfax = true;

    function startTimer(seguradora) {

        if (!timers[seguradora]) {
            timers[seguradora] = { minutes: 0, seconds: 0, interval: null };
        }

        timers[seguradora].interval = setInterval(() => {
            let timer = timers[seguradora];
            timer.seconds++;
            if (timer.seconds === 60) {
                timer.seconds = 0;
                timer.minutes++;
            }
            updateTimerDisplay(seguradora);
        }, 1000);
    }

    function stopTimer(seguradora) {
        if (timers[seguradora]) {
            clearInterval(timers[seguradora].interval);
            timers[seguradora].interval = null;
        }
    }

    function updateTimerDisplay(seguradora) {
        let timer = timers[seguradora];
        const formattedMinutes = String(timer.minutes).padStart(2, '0');
        const formattedSeconds = String(timer.seconds).padStart(2, '0');
        const timerElement = document.getElementById(`timer${capitalizeFirstLetter(seguradora)}`);
        if (timerElement) {
            timerElement.textContent = `${formattedMinutes}:${formattedSeconds}`;
        }
    }

    function capitalizeFirstLetter(string) {
        return string.charAt(0).toUpperCase() + string.slice(1);
    }

    function allCotacoesConcluidas() {
        return Object.values(cotacoesConcluidas).every(val => val === true);
    }

    function adicionarLinhaTabela(seguradora, numeroCotacao, premio) {
        var tabela = document.getElementById('tabelaRetornoCotacoes').getElementsByTagName('tbody')[0];
        var novaLinha = tabela.insertRow();
        var colunas = [
            seguradora,
            numeroCotacao,
            premio
        ];
        colunas.forEach(function (valor) {
            var coluna = novaLinha.insertCell();
            coluna.appendChild(document.createTextNode(valor));
        });
    }

    function atualizarCotacao() {
        console.log("Atualizando cotações...");

        if (cotacaoConcluida) return;

        console.log("Há cotações pendentes.");

        var idCotacao = '@Model.Cotacao.Id';
        var url = `/Cotacao/ObterRetornosPorCotacaoId?id=${idCotacao}`;
        cotacoesArray = [];
        fetch(url)
            .then(response => response.json())
            .then(data => {
                data.forEach(retorno => {
                    console.log("Cotação recebida para a seguradora ", retorno.seguradora, " com retorno ", retorno);
                    if (retorno.cotacaoId == '@Model.Cotacao.Id') {
                        console.log("Match de cotação realizado com sucesso.");
                        console.log("Atualizando cotação da seguradora ", retorno.seguradora, " com retorno ", retorno);

                        let seguradora = retorno.seguradora.toLowerCase();
                        stopTimer(seguradora);
                        cotacoesConcluidas[seguradora] = true;

                        if (retorno.seguradora.toLowerCase() == "mapfre") {
                            document.getElementById("spinnerMapfre").style.visibility = "hidden";
                            document.getElementById("numeroCotacaoMapfre").textContent = retorno.numeroCotacao;
                            document.getElementById("premioCotacaoMapfre").textContent = retorno.premio;
                            document.getElementById("retornoCotacaoMapfre").textContent = retorno.mensagemComplementar;
                            retornoMapfre = true;
                        } else if (retorno.seguradora.toLowerCase() == "swissre") {
                            document.getElementById("numeroCotacaoSwissRe").textContent = retorno.numeroCotacao;
                            document.getElementById("premioCotacaoSwissRe").textContent = retorno.premio;
                            document.getElementById("retornoCotacaoSwissRe").textContent = retorno.mensagemComplementar;
                            retornoSwissRe = true;
                        } else if (retorno.seguradora.toLowerCase() == "allianz") {
                            document.getElementById("spinnerAllianz").style.visibility = "hidden";
                            document.getElementById("numeroCotacaoAllianz").textContent = retorno.numeroCotacao;
                            document.getElementById("premioCotacaoAllianz").textContent = retorno.premio;
                            document.getElementById("retornoCotacaoAllianz").textContent = retorno.mensagemComplementar;
                            retornoAllianz = true;
                        } else if (retorno.seguradora.toLowerCase() == "tokio") {
                            document.getElementById("spinnerTokio").style.visibility = "hidden";
                            document.getElementById("numeroCotacaoTokio").textContent = retorno.numeroCotacao;
                            document.getElementById("premioCotacaoTokio").textContent = retorno.premio;
                            document.getElementById("retornoCotacaoTokio").textContent = retorno.mensagemComplementar;
                            retornoTokio = true;
                        } else if (retorno.seguradora.toLowerCase() == "sompo") {
                            document.getElementById("spinnerSompo").style.visibility = "hidden";
                            document.getElementById("numeroCotacaoSompo").textContent = retorno.numeroCotacao;
                            document.getElementById("premioCotacaoSompo").textContent = retorno.premio;
                            document.getElementById("retornoCotacaoSompo").textContent = retorno.mensagemComplementar;
                            retornoSompo = true;
                        } else if (retorno.seguradora.toLowerCase() == "pottencial") {
                            document.getElementById("numeroCotacaoPottencial").textContent = retorno.numeroCotacao;
                            document.getElementById("premioCotacaoPottencial").textContent = retorno.premio;
                            document.getElementById("retornoCotacaoPottencial").textContent = retorno.mensagemComplementar;
                            retornoPottencial = true;
                        } else if (retorno.seguradora.toLowerCase() == "fairfax") {
                            document.getElementById("spinnerFairfax").style.visibility = "hidden";
                            document.getElementById("numeroCotacaoFairfax").textContent = retorno.numeroCotacao;
                            document.getElementById("premioCotacaoFairfax").textContent = retorno.premio;
                            document.getElementById("retornoCotacaoFairfax").textContent = retorno.mensagemComplementar;
                            retornoPottencial = true;
                        }

                        if (allCotacoesConcluidas()) {
                            cotacaoConcluida = true;
                            alert("Cotações finalizadas!");
                        }

                        if (retorno.premio != "0") {
                            cotacoesArray.push({
                                seguradora: retorno.seguradora.toLowerCase(),
                                numeroCotacao: retorno.numeroCotacao,
                                premio: retorno.premio.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })
                            });

                            adicionarLinhaTabela(retorno.seguradora.toLowerCase(), retorno.numeroCotacao, retorno.premio.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }));
                        }

                        ordenarPorPremio();
                        adicionarTermometroCores();
                    }
                });
            });
    }

    function initCotacao() {
        startTimer('mapfre');
        startTimer('swissre');
        startTimer('allianz');
        startTimer('tokio');
        startTimer('sompo');
        startTimer('pottencial');
        startTimer('sombrero');
        startTimer('fairfax');
    }

    document.addEventListener("DOMContentLoaded", function () {
        initCotacao();
        console.log("Inicializando...");
        setInterval(atualizarCotacao, 30000);
    });

    function ordenarPorPremio() {
        cotacoesArray.sort(function (a, b) {
            var precoA = parseFloat(a.premio.replace('R$', '').replace('.', '').replace(',', '.'));
            var precoB = parseFloat(b.premio.replace('R$', '').replace('.', '').replace(',', '.'));
            return precoA - precoB;
        });

        var tabela = document.getElementById('tabelaRetornoCotacoes').getElementsByTagName('tbody')[0];
        tabela.innerHTML = '';

        cotacoesArray.forEach(function (cotacao) {
            var novaLinha = tabela.insertRow();
            var colunas = [cotacao.seguradora, cotacao.numeroCotacao, cotacao.premio];
            colunas.forEach(function (valor) {
                var coluna = novaLinha.insertCell();
                coluna.appendChild(document.createTextNode(valor));
            });
        });
    }
</script>

<script>
    document.getElementById("editarCotacao").addEventListener("click", function () {
        window.history.back();
    });
</script>
