@model MCR.API.Entities.CotacaoEntity
@{
    ViewData["Title"] = "Cotações - Nova Cotação";
}
<div class="form-box">
    <h4 class="form-title form-box-title justify-content-center align-items-center">Cotações - Nova Cotação</h4>
    <br /><br />
    <div class="row">
        <div class="col-md-3">
            <a asp-action="Index" asp-controller="Home" class="default-btn btn d-flex justify-content-center align-items-center">
                Voltar
            </a>
        </div>
    </div>
    <br /><br />
    <h6>Nova Cotação</h6>
    <p>
        Informe todos os campos para realizar uma nova cotação em todas as seguradoras.
    </p>
    <br />
    <form asp-controller="Cotacao" asp-action="NovaCotacao" method="post" id="novaCotacao">
        <br />
        @if (Model != null && !Model.Sucesso && !string.IsNullOrEmpty(Model.Mensagem))
        {
            <br />
            <div class="alert alert-warning text-center" role="alert" style="color: #b59900; border-radius: 15px">
                <h6>Atenção!</h6>
                <h6>@Model.Mensagem</h6>
            </div>
        }
        <br />
        <h6>Informações do Seguro</h6>
        <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)">
            <div class="card-body" style="color: var(--color-primary)">
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="TempoVigenciaSeguro" asp-for="InformacaoSeguro.TempoVigenciaSeguro" id="TempoVigenciaSeguro" required>
                                <option value="">Vigência</option>
                                <option value="1 Ano">1 Ano</option>
                                <option value="2 Anos">2 Anos</option>
                                <option value="3 Anos">3 Anos</option>
                                <option value="4 Anos">4 Anos</option>
                                <option value="5 Anos">5 Anos</option>
                            </select>
                            <label>Tempo de Vigência</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="TipoSeguro" asp-for="InformacaoSeguro.TipoSeguro" id="TipoSeguro" required>
                                <option value="">Tipo</option>
                                <option value="Novo">Novo</option>
                                <option value="Renovação com Sinistro">Renovação com Sinistro</option>
                                <option value="Renovação sem Sinistro">Renovação sem Sinistro</option>
                            </select>
                            <label>Tipo de Seguro</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="PrazoSeguro" asp-for="InformacaoSeguro.PrazoSeguro" id="PrazoSeguro">
                                <option value="">Prazo do Seguro</option>
                                <option value="Anual">Anual</option>
                                <option value="Pró-rata">Pró-rata</option>
                                <option value="Plurianual">Plurianual</option>
                            </select>
                            <label>Prazo do Seguro</label>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-8">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="SeguradoraAnterior" asp-for="InformacaoSeguro.SeguradoraAnterior" id="SeguradoraAnterior" asp-items="ViewBag.SeguradoraAnterior">
                                <option value="">Seguradora Anterior</option>
                            </select>
                            <label>Seguradora Anterior</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <input type="text" class="form-control form-input form-control-placeholder" asp-for="InformacaoSeguro.ApoliceRenovacao" id="ApoliceRenovacao" placeholder="Apolice Renovação">
                            <label for="ApoliceRenovacao">Apolice Renovação</label>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="BemFinanciado" asp-for="InformacaoSeguro.BemFinanciado" id="BemFinanciado" required>
                                <option value="">Sim/Não</option>
                                <option value="Sim">Sim</option>
                                <option value="Não">Não</option>
                            </select>
                            <label>Bem é financiado?</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-8">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="BancoBeneficiario" asp-for="InformacaoSeguro.BancoBeneficiarioInformacaoSeguro" id="BancoBeneficiarioInformacaoSeguro" asp-items="ViewBag.Bancos">
                                <option value="">Banco</option>
                                @if (Model != null && Model.Parametrizacao != null && Model.Parametrizacao.Beneficiario != null && Model.Parametrizacao.Beneficiario.Beneficiario != null)
                                {
                                    if (!string.IsNullOrEmpty(Model.Parametrizacao.Beneficiario.Beneficiario.Banco))
                                    {
                                        <option value="@Model.Parametrizacao.Beneficiario.Beneficiario.Banco" selected>@Model.Parametrizacao.Beneficiario.Beneficiario.Banco</option>
                                    }
                                }
                            </select>
                            <label>Banco</label>
                        </div>
                    </div>
                    <input type="hidden" asp-for="InformacaoSeguro.QuantidadeParcelas" id="QuantidadeParcelas" value="1" />
                    <input type="hidden" asp-for="InformacaoSeguro.FormaPagamentoSeguro" id="FormaPagamentoSeguro" value="Débito em conta" />
                </div>
                <br />
            </div>
        </div>
        <br />
        <h6>Informações do Segurado</h6>
        <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)">
            <div class="card-body" style="color: var(--color-primary)">
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <input type="text" class="form-control form-input form-control-placeholder" asp-for="InformacaoSegurado.Nome" id="Nome" placeholder="Nome" required>
                            <label for="Nome">Nome</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="TipoSeguro" asp-for="InformacaoSegurado.TipoPessoa" id="TipoPessoa" required>
                                <option value="">Tipo de Pessoa</option>
                                <option value="Física">Física</option>
                                <option value="Jurídica">Jurídica</option>
                            </select>
                            <label>Tipo de Pessoa</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <input type="number" min="1" class="form-control form-input form-control-placeholder" asp-for="InformacaoSegurado.CPFCNPJ" id="CPFCNPJ" placeholder="CPF/CNPJ" required>
                            <label for="CPFCNPJ">CPF/CNPJ</label>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <p>Informe o CEP para o preenchimento automático do endereço.</p>
                    <div class="col-sm-12 col-md-12 col-lg-3">
                        <div class="form-floating">
                            <input type="number" class="form-control form-input form-control-placeholder" asp-for="InformacaoSegurado.CEP" id="CEP" placeholder="CEP" required>
                            <label for="CEP">CEP</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <input type="text" class="form-control form-input form-control-placeholder" asp-for="InformacaoSegurado.Cidade" id="Cidade" placeholder="Cidade" required>
                            <label for="Cidade">Cidade</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-5">
                        <div class="form-floating">
                            <input type="text" class="form-control form-input form-control-placeholder" asp-for="InformacaoSegurado.Endereco" id="Endereco" placeholder="Endereço" required>
                            <label for="Endereco">Endereço</label>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-3">
                        <div class="form-floating">
                            <input type="number" class="form-control form-input form-control-placeholder" asp-for="InformacaoSegurado.Numero" id="Numero" placeholder="Núm." value="1" required>
                            <label for="Numero">Núm.</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <input type="text" class="form-control form-input form-control-placeholder" asp-for="InformacaoSegurado.Bairro" id="Bairro" placeholder="Bairro" required>
                            <label for="Bairro">Bairro</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-2">
                        <div class="form-floating">
                            <input type="text" class="form-control form-input form-control-placeholder" asp-for="InformacaoSegurado.Estado" id="Estado" placeholder="UF" required>
                            <label for="Estado">UF</label>
                        </div>
                    </div>
                </div>
                <br />
            </div>
        </div>
        <br />
        <hr />
        <h5>Informações Sobre o Bem</h5>
        <br />
        <h6>Equipamento</h6>
        <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)">
            <div class="card-body" style="color: var(--color-primary)">
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="TipoEquipamento" asp-for="CotacaoInformacaoBem.TipoEquipamento" id="TipoEquipamento" asp-items="ViewBag.Equipamentos">
                                <option value="">Tipo de Equipamento</option>
                            </select>
                            <label>Tipo de Equipamento</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <small class="d-inline-flex mb-3 px-2 py-1 fw-semibold text-primary-emphasis bg-success-subtle border border-success-subtle rounded-2">Allianz e Tokio: no máximo 20 anos.</small>
                        <div class="form-floating">
                            <input type="number" min="1900" maxlength="4" max="@DateTime.UtcNow.AddYears(1).Year" step="1" class="form-control form-input form-control-placeholder" asp-for="CotacaoInformacaoBem.AnoFabricacao" id="AnoFabricacao" placeholder="Ano de Fabricação" required>
                            <label for="AnoFabricacao">Ano de Fabricação</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <input type="number" min="1" class="form-control form-input form-control-placeholder" asp-for="CotacaoInformacaoBem.ValorEquipamento" id="ValorEquipamento" placeholder="Valor" required>
                            <label for="ValorEquipamento">Valor</label>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="MarcaEquipamento" asp-for="CotacaoInformacaoBem.MarcaEquipamento" id="MarcaEquipamento" asp-items="ViewBag.Marcas">
                                <option value="">Marcas</option>
                            </select>
                            <label>Marcas</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="ModeloEquipamento" asp-for="CotacaoInformacaoBem.ModeloEquipamento" id="ModeloEquipamento" asp-items="ViewBag.Modelos">
                                <option value="">Modelos</option>
                            </select>
                            <label>Modelos</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <input type="text" class="form-control form-input form-control-placeholder" asp-for="CotacaoInformacaoBem.NumeroSerieEquipamento" id="NumeroSerieEquipamento" placeholder="Núm. Série" required>
                            <label for="NumeroSerieEquipamento">Núm. Série</label>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="InformarNotaFiscal" asp-for="CotacaoInformacaoBem.InformarNotaFiscal" id="InformarNotaFiscal">
                                <option value="">Informar NF?</option>
                                <option value="Sim">Sim</option>
                                <option value="Não">Não</option>
                            </select>
                            <label>Informar NF?</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <input type="date" class="form-control form-input form-control-placeholder" asp-for="CotacaoInformacaoBem.DataNotaFiscal" id="DataNotaFiscal" placeholder="Data Nota Fiscal">
                            <label for="DataNotaFiscal">Data Nota Fiscal</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <input type="number" min="1" class="form-control form-input form-control-placeholder" asp-for="CotacaoInformacaoBem.NumeroNotaFiscal" id="NumeroNotaFiscal" placeholder="Núm. Nota Fiscal">
                            <label for="NumeroNotaFiscal">Núm. Nota Fiscal</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <br />
        <h6>Formulário de Risco</h6>
        <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)">
            <div class="card-body" style="color: var(--color-primary)">
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-6">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="EquipamentoAlugadoDuranteVigencia" asp-for="CotacaoFormularioRisco.EquipamentoAlugadoDuranteVigencia" id="EquipamentoAlugadoDuranteVigencia" required>
                                <option value="">Sim/Não</option>
                                <option value="Sim">Sim</option>
                                <option value="Não">Não</option>
                            </select>
                            <label>Poderá ser alugado durante a vigência do seguro?</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-6">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="EquipamentoCedidoTerceirosDuranteVigencia" asp-for="CotacaoFormularioRisco.EquipamentoCedidoTerceirosDuranteVigencia" id="EquipamentoCedidoTerceirosDuranteVigencia" required>
                                <option value="">Sim/Não</option>
                                <option value="Sim">Sim</option>
                                <option value="Não">Não</option>
                            </select>
                            <label>Poderá ser cedido à terceiros durante a vigência do seguro?</label>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-6">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="EquipamentoAtividadesRurais" asp-for="CotacaoFormularioRisco.EquipamentoAtividadesRurais" id="EquipamentoAtividadesRurais" required>
                                <option value="">Sim/Não</option>
                                <option value="Sim">Sim</option>
                                <option value="Não">Não</option>
                            </select>
                            <label>Destinado à zonas rurais (agrícola e/ou pecuária)?</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-6">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="EquipamentoAtividadeFlorestal" asp-for="CotacaoFormularioRisco.EquipamentoAtividadeFlorestal" id="EquipamentoAtividadeFlorestal" required>
                                <option value="">Sim/Não</option>
                                <option value="Sim">Sim</option>
                                <option value="Não">Não</option>
                            </select>
                            <label>Utilizado em atividades florestais?</label>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-6">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="EquipamentoOperaProximoAgua" asp-for="CotacaoFormularioRisco.EquipamentoOperaProximoAgua" id="EquipamentoOperaProximoAgua" required>
                                <option value="">Sim/Não</option>
                                <option value="Sim">Sim</option>
                                <option value="Não">Não</option>
                            </select>
                            <label>Equipamento opera próximo à água?</label>
                        </div>
                        @if (Model.ParametrizacaoMultiCalculoParceiro.HabilitarSombrero)
                        {
                            <div class="row">
                                <div class="col-sm-12 col-md-12 col-lg-6">
                                    <div class="form-floating">
                                        <input type="text" class="form-control form-input form-control-placeholder" asp-for="SombreroCoberturas.ValorOperaProximoAgua" id="ValorOperaProximoAgua" placeholder="Valor" />
                                        <label>Valor Opera Próxima a Água</label>
                                    </div>
                                </div>
                            </div>
                            <br />
                        }
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-6">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="EquipamentoOperaProximoAgua" asp-for="CotacaoFormularioRisco.SeguradoColaboradorOperador" id="SeguradoColaboradorOperador" required>
                                <option value="">Sim/Não</option>
                                <option value="Sim">Sim</option>
                                <option value="Não">Não</option>
                            </select>
                            <label>Operado pelo Segurado/Colaborador?</label>
                        </div>
                    </div>
                </div>
                <br />
            </div>
        </div>
        <br />
        <h6>Cobertura</h6>
        <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)" id="cardCoberturaRiscos">
            <div class="card-body" style="color: var(--color-primary)">
                <input type="hidden" asp-for="CotacaoCobertura.AplicarCoberturaTotal" id="AplicarCoberturaTotal" value="Sim" />
                <p>Cobertura básica é aplicada por padrão, sendo, sempre, o valor do equipamento.</p>
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-6">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="ContratarResponsabilidadeCivilMaquinariaAgricola" asp-for="CotacaoCobertura.ContratarResponsabilidadeCivilMaquinariaAgricola" id="ContratarResponsabilidadeCivilMaquinariaAgricola" required>
                                <option value="">Sim/Não</option>
                                @if (Model != null && Model.Parametrizacao != null && Model.Parametrizacao.Seguradora != null && Model.Parametrizacao.Seguradora.Seguradora != null)
                                {
                                    if (Model.Parametrizacao.Seguradora.Seguradora.ContratarCoberturaResponsabilidadeCivilParaMaquinaAgricola)
                                    {
                                        <option value="Sim" selected>Sim</option>
                                        <option value="Não">Não</option>
                                    }
                                    else
                                    {
                                        <option value="Sim">Sim</option>
                                        <option value="Não" selected>Não</option>
                                    }
                                }
                                else
                                {
                                    <option value="Sim">Sim</option>
                                    <option value="Não">Não</option>
                                }
                            </select>
                            <label>Responsabilidade civil para máquinária agrícola?</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-6">
                        <div class="form-floating">
                            @if (Model != null && Model.Parametrizacao != null && Model.Parametrizacao.Seguradora != null && Model.Parametrizacao.Seguradora.Seguradora != null)
                            {
                                if (Model.Parametrizacao.Seguradora.Seguradora.ContratarCoberturaResponsabilidadeCivilParaMaquinaAgricola)
                                {
                                    <input type="text" class="form-control form-input form-control-placeholder" asp-for="CotacaoCobertura.ValorResponsabilidadeCivilMaquinariaAgricola" id="ValorResponsabilidadeCivilMaquinariaAgricola" placeholder="Valor" value="@Model.Parametrizacao.Seguradora.Seguradora.ValorCoberturaResponsabilidadeCivilParaMaquinaAgricola" required>
                                }
                                else
                                {
                                    <input type="text" class="form-control form-input form-control-placeholder" asp-for="CotacaoCobertura.ValorResponsabilidadeCivilMaquinariaAgricola" id="ValorResponsabilidadeCivilMaquinariaAgricola" placeholder="Valor" value="0">
                                }
                            }
                            <label for="ValorResponsabilidadeCivilMaquinariaAgricola">Valor</label>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-6">
                        <div class="form-floating">
                            <select class="form-select form-dropdownlist" aria-label="ContratarResponsabilidadeCivilEmpregador" asp-for="CotacaoCobertura.ContratarResponsabilidadeCivilEmpregador" id="ContratarResponsabilidadeCivilEmpregador" required>
                                <option value="">Sim/Não</option>
                                @if (Model != null && Model.Parametrizacao != null && Model.Parametrizacao.Seguradora != null && Model.Parametrizacao.Seguradora.Seguradora != null)
                                {
                                    if (Model.Parametrizacao.Seguradora.Seguradora.ContratarCoberturaResponsabilidadeCivilParaEmpregador)
                                    {
                                        <option value="Sim" selected>Sim</option>
                                        <option value="Não">Não</option>
                                    }
                                    else
                                    {
                                        <option value="Sim">Sim</option>
                                        <option value="Não" selected>Não</option>
                                    }
                                }
                            </select>
                            <label>Responsabilidade civil para empregador?</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-6">
                        <div class="form-floating">
                            @if (Model != null && Model.Parametrizacao != null && Model.Parametrizacao.Seguradora != null && Model.Parametrizacao.Seguradora.Seguradora != null)
                            {
                                if (Model.Parametrizacao.Seguradora.Seguradora.ContratarCoberturaResponsabilidadeCivilParaEmpregador)
                                {
                                    <input type="text" class="form-control form-input form-control-placeholder" asp-for="CotacaoCobertura.ValorResponsabilidadeCivilEmpregador" id="ValorResponsabilidadeCivilEmpregador" placeholder="Valor" value="@Model.Parametrizacao.Seguradora.Seguradora.ValorCoberturaResponsabilidadeCivilParaEmpregador" required>
                                }
                                else
                                {
                                    <input type="text" class="form-control form-input form-control-placeholder" asp-for="CotacaoCobertura.ValorResponsabilidadeCivilEmpregador" id="ValorResponsabilidadeCivilEmpregador" placeholder="Valor" value="0">
                                }
                            }
