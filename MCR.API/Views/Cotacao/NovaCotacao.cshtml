<script>
    document.getElementById("TipoSeguro").addEventListener("change", function () {
        const tipoSeguro = this.value;
        document.getElementById("ApoliceRenovacao").value = '';
        document.getElementById("SeguradoraAnterior").value = '';
        if (tipoSeguro === 'Renovação sem Sinistro') {
            document.getElementById("ApoliceRenovacao").disabled = false;
            document.getElementById("SeguradoraAnterior").disabled = false;
        }
        else if (tipoSeguro === 'Renovação com Sinistro') {
            document.getElementById("ApoliceRenovacao").disabled = false;
            document.getElementById("SeguradoraAnterior").disabled = false;
        } else {
            document.getElementById("ApoliceRenovacao").disabled = true;
            document.getElementById("SeguradoraAnterior").disabled = true;
        }

    });
</script>

<script>
    document.getElementById("BemFinanciado").addEventListener("change", function () {
        const tipoSeguro = this.value;
        document.getElementById("BancoBeneficiarioInformacaoSeguro").value = '';
        if (tipoSeguro === 'Sim') {
            document.getElementById("BancoBeneficiarioInformacaoSeguro").disabled = false;
        } else {
            document.getElementById("BancoBeneficiarioInformacaoSeguro").disabled = true;
        }
    });
</script>
<script>
    document.getElementById("InformarNotaFiscal").addEventListener("change", function () {
