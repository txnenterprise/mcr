

@model MCR.API.Models.ViewModels.CorretoraModel
@{
    ViewData["Title"] = "Corretoras";
}
<div class="form-box">
    <h4 class="form-title form-box-title justify-content-center align-items-center">Corretoras</h4>
    <br /><br />
    <div class="row">
        <div class="col-md-2">
            <a asp-action="Cadastrar" asp-controller="Corretora" class="btn btn-secondary rounded-pill">
                Cadastrar
            </a>
        </div>
    </div>
    <br /><br />
    <div style="overflow-x:auto;">
        <table id="table-grid" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Razão Social</th>
                    <th>Nome Fantasia</th>
                    <th>CNPJ</th>
                    <th>Cidade</th>
                    <th>Ativo?</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.ListaCorretoras != null && Model.ListaCorretoras.Count > 0 && Model.ListaCorretoras[0].Sucesso == true)
                {
                    foreach (var item in Model.ListaCorretoras)
                    {
                        <tr>
                            <td>@item.RazaoSocial</td>
                            <td>@item.NomeFantasia</td>
                            <td>@item.CNPJ</td>
                            <td>@item.Cidade</td>
                            <td>@(item.Ativa ? "Sim" : "Não")</td>
                            <td>
                                <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Editar</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>