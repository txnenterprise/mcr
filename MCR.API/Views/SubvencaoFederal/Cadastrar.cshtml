@model MCR.API.Models.ViewModels.SubvencaoFederalModel
@{
    ViewData["Title"] = "Subvenções Federais - Cadastrar";
}
<div class="form-box">
    <h4 class="form-title form-box-title justify-content-center align-items-center">Subvenções Federais - Cadastrar</h4>
    <br /><br />
    <div class="row">
        <div class="col-md-2">
            <a asp-action="Index" asp-controller="SubvencaoFederal" class="btn btn-secondary rounded-pill">
                Voltar
            </a>
        </div>
    </div>
    <br /><br />
    <form asp-controller="SubvencaoFederal" asp-action="Cadastrar" method="post">
        <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)">
            <div class="card-body" style="color: var(--color-primary)">
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <select class="form-select" asp-for="SubvencaoFederal.Cultura" id="Cultura" asp-items="ViewBag.Cultura">
                                <option value="">Selecione...</option>
                            </select>
                            <label for="Cultura">Cultura</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <select class="form-select" asp-for="SubvencaoFederal.Porentagem" id="Porentagem" placeholder="Porcentagem" required>
                                <option value="">Selecione...</option>
                                <option value="5">5%</option>
                                <option value="10">10%</option>
                                <option value="15">15%</option>
                                <option value="20">20%</option>
                                <option value="25">25%</option>
                                <option value="30">30%</option>
                                <option value="35">35%</option>
                                <option value="40">40%</option>
                                <option value="45">45%</option>
                                <option value="50">50%</option>
                                <option value="55">55%</option>
                                <option value="60">60%</option>
                                <option value="65">65%</option>
                                <option value="70">70%</option>
                                <option value="75">75%</option>
                                <option value="80">80%</option>
                                <option value="85">85%</option>
                                <option value="90">90%</option>
                                <option value="95">95%</option>
                                <option value="100">100%</option>
                            </select>
                            <label for="Porentagem">Porcentagem</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <div class="form-floating">
                            <input type="number" step="0.01" class="form-control form-input form-control-placeholder" asp-for="SubvencaoFederal.LimiteReal" id="LimiteReal" placeholder="Limite R$" required>
                            <label for="LimiteReal">Limite R$</label>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-6">
                        <div class="form-floating">
                            <input type="text" class="form-control form-input form-control-placeholder" asp-for="SubvencaoFederal.AnoCivil" id="AnoCivil" placeholder="Ano Civil" required>
                            <label for="AnoCivil">Ano Civil</label>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-6">
                        <div class="form-check form-switch pt-3">
                            <input class="form-check-input" type="checkbox" asp-for="SubvencaoFederal.Ativo" id="Ativo">
                            <label class="form-check-label" for="Ativo">Ativo?</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <br />
        <div class="social-login">
            <button type="submit" class="btn btn-success rounded-pill">
                Salvar
            </button>
        </div>
    </form>
    @if (Model != null && !Model.SubvencaoFederal.Sucesso)
    {
        <br />
        <div class="alert alert-warning text-center" role="alert" style="color: #b59900; border-radius: 15px">
            <h6>Atenção!</h6>
            <h6>@Model.SubvencaoFederal.Mensagem</h6>
        </div>
    }
</div>
