@inject MCR.API.Services.Interfaces.ICanalService CanalService
@model MCR.API.Models.ViewModels.PontoAtendimentoModel
@{
    ViewData["Title"] = "Pontos de Atendimento - Cadastrar";

    System.Collections.Generic.IEnumerable<MCR.API.Entities.CanalEntity> canaisDoBanco = null;
    try
    {
        canaisDoBanco = await CanalService.ObterTodosPaginadoAsync(null, null, 1, 999);
    }
    catch (Exception ex)
    {
        <script>console.error('Erro ao carregar canais:', '@ex.Message');</script>
    }
    var canaisFromInject = canaisDoBanco?.ToList() ?? new List<MCR.API.Entities.CanalEntity>();
}
<script>
console.log('DEBUG PontoAtendimento Cadastrar - canais via inject:', @canaisFromInject.Count);
@foreach (var c in canaisFromInject)
{
    <text>console.log('  canal:', '@c.Id', '@c.RazaoSocial');</text>
}
</script>
