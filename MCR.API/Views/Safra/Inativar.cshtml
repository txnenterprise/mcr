@model MCR.API.Models.ViewModels.SafraModel
@{
    if (Model.Safra.Ativo)
        ViewData["Title"] = "Safras - Inativar";
    else
        ViewData["Title"] = "Safras - Ativar";
}
<div class="form-box">
    @if (Model.Safra.Ativo)
    {
        <h4 class="form-title form-box-title justify-content-center align-items-center">Safras - Inativar</h4>
    }
    else
    {
        <h4 class="form-title form-box-title justify-content-center align-items-center">Safras - Ativar</h4>
    }
    <br /><br />
    <div class="row">
        <div class="col-md-2">
            <a asp-action="Index" asp-controller="Safra" class="btn btn-secondary rounded-pill">
                Voltar
            </a>
        </div>
    </div>
    <br /><br />
    <div class="row">
        <div class="col-sm-12 col-md-6 col-lg-6">
            <form asp-controller="Safra" method="post" id="inativarSafra">
                <ul class="list-group">
                    <li class="list-group-item">Descrição: @Model.Safra.Descricao</li>
                    <li class="list-group-item">Ano de Referência: @Model.Safra.AnoReferencia</li>
                    <li class="list-group-item">Ativo? @(Model.Safra.Ativo ? "Sim" : "Não")</li>
                </ul>
                <input asp-for="Safra.Id" value="@Model.Safra.Id" hidden>
                <br />
                <br />
                @if (Model.Safra.Ativo)
                {
                    <div class="alert alert-warning" role="alert">
                        <h6>Deseja, realmente, inativar este cadastro?</h6>
                    </div>
                    <br />
                    <div class="social-login">
                        <button type="submit" action="Inativar" class="login-btn btn d-flex justify-content-center align-items-center" onclick="setAction('Inativar')">
                            Inativar
                        </button>
                    </div>
                }
                else
                {
                    <div class="social-login">
                        <button type="submit" class="login-btn btn d-flex justify-content-center align-items-center" onclick="setAction('Ativar')">
                            Ativar
                        </button>
                    </div>
                }
            </form>
            @if (Model != null && !Model.Safra.Sucesso)
            {
                <br />
                <div class="alert alert-warning text-center" role="alert" style="color: #b59900; border-radius: 15px">
                    <h6>Atenção!</h6>
                    <h6>@Model.Safra.Mensagem</h6>
                </div>
            }
        </div>
    </div>
</div>
<script>
    function setAction(action) {
        document.getElementById("inativarSafra").action = '/Safra/' + action;
    }
</script>
