
@model MCR.API.Models.ViewModels.ForgotPasswordModel

<div class="d-lg-flex half">
    <div class="bg order-1 order-md-2" style="background-image: url('../img/customer-background-login.png'); border-radius:15px"></div>
    <div class="contents order-2 order-md-1">
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-md-7">
                    <h5>Esqueci Minha Senha</h5>
                    <form asp-controller="Login" asp-action="ForgotPassword" method="post">
                        <div class="col-md-12">
                            <div class="form-floating">
                                <input type="email" class="form-control login-input form-control-placeholder" asp-for="Email" id="Email" placeholder="E-Mail" required>
                                <label for="Email">E-Mail</label>
                            </div>
                            <br />
                            <div class="social-login">
                                <div class="social-login">
                                    <button type="submit" class="login-btn btn d-flex justify-content-center align-items-center">
                                        Enviar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                    @if (Model != null && !Model.Sucesso)
                    {
                        <br />
                        <div class="alert alert-warning text-center" role="alert" style="color: #b59900; border-radius: 15px">
                            <h6>Atenção!</h6>
                            <h6>@Model.Mensagem</h6>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>