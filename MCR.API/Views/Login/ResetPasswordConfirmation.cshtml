<div class="d-lg-flex half">
    <div class="bg order-1 order-md-2" style="background-image: url('../img/customer-background-login.png'); border-radius:15px"></div>
    <div class="contents order-2 order-md-1">
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-md-7">
                    <div class="col-md-12">
                        <h4 class="text-success">Senha alterada com sucesso!</h4>
                        <br/>
                        <div class="social-login">
                            <button type="submit" class="login-btn btn d-flex justify-content-center align-items-center">
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"> </span>
                                 <span id="countdown"></span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function startCountdown() {
        var countdown = 3;

        var interval = setInterval(function () {
            document.getElementById('countdown').textContent = "  Redirecionando para o login em  " + countdown;
            if (countdown === 0) {
                clearInterval(interval);
                window.location.href = '@Url.Action("Authentication", "Login")';
            } else {
                countdown--;
            }
        }, 1000);
    }
    document.addEventListener('DOMContentLoaded', startCountdown);
</script>