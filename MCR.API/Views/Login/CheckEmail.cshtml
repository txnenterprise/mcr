<div class="d-lg-flex half">
    <div class="bg order-1 order-md-2" style="background-image: url('../img/customer-background-login.png'); border-radius:15px"></div>
    <div class="contents order-2 order-md-1">
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-md-7">
                    <h5>Verificação de E-Mail "Esqueci Minha Senha"</h5>
                    <form action="#" method="post">
                        <div class="col-md-12">
                            <h4 class="text-success">E-mail enviado com sucesso!</h4>
                            <span class="d-block text-left my-4 text-muted">
                                <b>Atenção:</b><br />
                                Verifique sua caixa de entrada (inclusive spam), você receberá o link para redefinição de senha.
                                <br />
                                Não recebeu? 
                                <br/>
                                <br/>
                                <a asp-action="ForgotPassword" class="login-btn-others-adapters btn d-flex justify-content-center align-items-center">
                                    Clique aqui para reenviar.
                                </a>
                            </span>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>