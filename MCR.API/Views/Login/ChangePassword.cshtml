
@model MCR.API.Models.ViewModels.ResetPasswordModel

<div class="d-lg-flex half">
    <div class="bg order-1 order-md-2" style="background-image: url('../img/customer-background-login.png'); border-radius:15px"></div>
    <div class="contents order-2 order-md-1">
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-md-7">
                    <h5>Redefinir Senha</h5>
                    <form asp-controller="Login" asp-action="ChangePassword" method="post">
                        <div class="col-md-12">
                            <div class="accordion" id="accordionPassword">
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingOne">
                                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                            Dicas para a Senha
                                        </button>
                                    </h2>
                                    <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionPassword">
                                        <div class="accordion-body">
                                            <p>A senha deve conter, no mínimo, oito caracteres;</p>
                                            <p>A senha não pode conter números sequenciais;</p>
                                            <p>A senha deve conter, pelo menos, um caractere especial;</p>
                                            <p>A senha deve conter letras maiúsculas e minúsculas.
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <br />
                            <div class="form-floating">
                                <input type="email" class="form-control login-input form-control-placeholder" asp-for="Email" id="email" placeholder="E-Mail" required>
                                <label for="Email">E-Mail</label>
                            </div>
                            <br />
                            <div class="form-floating">
                                <input type="password" class="form-control login-input form-control-placeholder" asp-for="Password" id="Password" placeholder="Senha" required>
                                <label for="Password">Senha Atual</label>
                            </div>
                            <br />
                            <div class="form-floating">
                                <input type="password" class="form-control login-input form-control-placeholder" asp-for="ConfirmPassword" id="ConfirmPassword" placeholder="Confirmar Senha" required>
                                <label for="ConfirmPassword">Nova Senha</label>
                            </div>
                            <br />
                            <div class="social-login">
                                <button type="submit" class="login-btn btn d-flex justify-content-center align-items-center">
                                    Redefinir
                                </button>
                            </div>
                        </div>
                        <input type="hidden" asp-for="Email" class="form-control" />
                        <input type="hidden" asp-for="Token" class="form-control" />
                        <input type="hidden" asp-for="UserId" class="form-control" />
                    </form>
                    @if (Model != null && !Model.Sucesso)
                    {
                        <br />
                        <div class="alert alert-warning text-center" role="alert" style="color: #b59900; border-radius: 15px">
                            <h6>Atenção!</h6>
                            <h6>@Model.Mensagem</h6>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>