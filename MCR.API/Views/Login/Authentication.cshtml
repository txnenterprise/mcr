
@model MCR.API.Models.ViewModels.AuthenticationModel

<div class="container">
    <div class="row">
        <div class="col-lg-6"></div>
        <div class="col-lg-6 d-flex align-items-center justify-content-center right-side">
            <div class="form-2-wrapper">
                <div class="logo text-center">
                    <h2>Login</h2>
                </div>
                <form asp-controller="Login" asp-action="Authentication" method="post" id="loginForm">
                    <div class="mb-3">
                        <input type="email" class="form-control login-input form-control-placeholder" asp-for="Email" id="Email" placeholder="E-Mail" required>
                    </div>
                    <div class="mb-3">
                        <input type="password" class="form-control login-input form-control-placeholder" asp-for="Password" id="Password" placeholder="Senha" required>
                    </div>
