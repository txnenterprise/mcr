                    </div> *@
                    <input asp-for="ReturnUrl" type="hidden">
                </form>
                @if (Model != null && !Model.Sucesso)
                {
                    <br />
                    <div class="alert alert-warning text-center" role="alert" style="color: #b59900; border-radius: 15px">
                        <h6>Atenção!</h6>
                        <h6>@Model.Mensagem</h6>
                    </div>
                }
                <!-- Register Link -->
                <p class="text-center register-test mt-3"><a href="https://txnenterprise.com.br" class="text-decoration-none" target="_blank">txnenterprise.com.br</a></p>
            </div>
        </div>
    </div>
</div>
<style>
    body {
        margin: 0;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: url('/img/background.png');
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
        height: 100vh;
        font-family: 'Roboto', sans-serif;
    }

    .form-2-wrapper {
        background: #ffffff59;
        padding: 50px;
        border-radius: 8px;
        min-height: 500px;
        min-width: 500px;
    }

    input.form-control {
        padding: 11px;
        border: none;
        border: 2px solid #4cbb4f80;
        border-radius: 30px;
        background-color: transparent;
        font-family: Arial, Helvetica, sans-serif;
        font-size: medium;
    }

        input.form-control:focus {
            box-shadow: none !important;
            outline: 0px !important;
            background-color: transparent;
            font-size: large;
        }

    button.login-btn {
        background: #4cbb4f80;
        color: #fff;
        border: none;
        padding: 10px;
        border-radius: 30px;
        font-size: medium;
    }

    .register-test a {
        color: #000;
    }

    .social-login button {
        border-radius: 30px;
    }</style>