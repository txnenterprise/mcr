@using System.Globalization;
@model MCR.API.Models.ViewModels.CanalModel
@{
    ViewData["Title"] = "Estruturas de Negócio";
}
<div class="form-box">
    <h4 class="form-title form-box-title justify-content-center align-items-center">Estruturas de Negócio</h4>
    <br />
    <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)">
        <div class="card-body" style="color: var(--color-primary)">
            <h6>Filtros</h6>
            <br />
            <form asp-action="Index" method="get">
                <p>Pesquisa por Canal</p>
                <div class="row">
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <div class="form-group">
                            <label for="dataHoraCotacaoInicio">Canal - Razão Social</label>
                            <input type="text" class="form-control"
                                   asp-for="PesquisaRazaoSocial"
                                   value="@Model.PesquisaRazaoSocial" />
                        </div>
                    </div>
                    <br />
                    <div class="col-sm-12 col-md-3 col-lg-3">
                        <div class="form-group">
                            <label for="corretoraId">Canal - Ativo?</label>
                            <select class="form-select form-dropdownlist"
                                    asp-for="PesquisaAtivoInativo">
                                <option value="Todos">Todos</option>
                                <option value="Sim">Sim</option>
                                <option value="Não">Não</option>
                            </select>
                        </div>
                    </div>
                </div>
                <br />
                <p>Pesquisa por Ponto de Atendimento</p>
                <div class="row">
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <div class="form-group">
                            <label for="dataHoraCotacaoInicio">Ponto de Atendimento - Razão Social</label>
                            <input type="text" class="form-control"
                                   asp-for="PesquisaRazaoSocialPA"
                                   value="@Model.PesquisaRazaoSocial" />
                        </div>
                    </div>
                    <br />
                    <div class="col-sm-12 col-md-3 col-lg-3">
                        <div class="form-group">
                            <label for="corretoraId">Ponto de Atendimento - Ativo?</label>
                            <select class="form-select form-dropdownlist"
                                    asp-for="PesquisaAtivoInativoPA">
                                <option value="Todos">Todos</option>
                                <option value="Sim">Sim</option>
                                <option value="Não">Não</option>
                            </select>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <br />
                        <button type="submit" class="btn btn-primary">Filtrar</button>
                    </div>
                    <br />
                </div>
            </form>
        </div>
    </div>
    <br />
    <div class="row">
        <i>
            <svg fill="#899bbd" width="24px" height="24px" viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="M8 2L8 6L4 6L4 48L46 48L46 14L30 14L30 6L26 6L26 2 Z M 10 4L24 4L24 8L28 8L28 46L19 46L19 39L15 39L15 46L6 46L6 8L10 8 Z M 10 10L10 12L12 12L12 10 Z M 14 10L14 12L16 12L16 10 Z M 18 10L18 12L20 12L20 10 Z M 22 10L22 12L24 12L24 10 Z M 10 15L10 19L12 19L12 15 Z M 14 15L14 19L16 19L16 15 Z M 18 15L18 19L20 19L20 15 Z M 22 15L22 19L24 19L24 15 Z M 30 16L44 16L44 46L30 46 Z M 32 18L32 20L34 20L34 18 Z M 36 18L36 20L38 20L38 18 Z M 40 18L40 20L42 20L42 18 Z M 10 21L10 25L12 25L12 21 Z M 14 21L14 25L16 25L16 21 Z M 18 21L18 25L20 25L20 21 Z M 22 21L22 25L24 25L24 21 Z M 32 22L32 24L34 24L34 22 Z M 36 22L36 24L38 24L38 22 Z M 40 22L40 24L42 24L42 22 Z M 32 26L32 28L34 28L34 26 Z M 36 26L36 28L38 28L38 26 Z M 40 26L40 28L42 28L42 26 Z M 10 27L10 31L12 31L12 27 Z M 14 27L14 31L16 31L16 27 Z M 18 27L18 31L20 31L20 27 Z M 22 27L22 31L24 31L24 27 Z M 32 30L32 32L34 32L34 30 Z M 36 30L36 32L38 32L38 30 Z M 40 30L40 32L42 32L42 30 Z M 10 33L10 37L12 37L12 33 Z M 14 33L14 37L16 37L16 33 Z M 18 33L18 37L20 37L20 33 Z M 22 33L22 37L24 37L24 33 Z M 32 34L32 36L34 36L34 34 Z M 36 34L36 36L38 36L38 34 Z M 40 34L40 36L42 36L42 34 Z M 32 38L32 40L34 40L34 38 Z M 36 38L36 40L38 40L38 38 Z M 40 38L40 40L42 40L42 38 Z M 10 39L10 44L12 44L12 39 Z M 22 39L22 44L24 44L24 39 Z M 32 42L32 44L34 44L34 42 Z M 36 42L36 44L38 44L38 42 Z M 40 42L40 44L42 44L42 42Z"></path></g></svg>
        </i>
        <span>Canal</span>
        <i>
            <svg width="24px" height="24px" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M1 6V15H6V11C6 9.89543 6.89543 9 8 9C9.10457 9 10 9.89543 10 11V15H15V6L8 0L1 6Z" fill="#899bbd"></path> </g></svg>
        </i>
        <span>Ponto de Atendimento</span>
    </div>
    <br />
    <div style="overflow-x:auto;">
        <table id="tblCadastro" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <td>
                    </td>
                    <th>Razão Social</th>
                    <th>Nome Fantasia</th>
                    <th>CNPJ</th>
                    <th>Cidade/Estado</th>
                    <th>Ativo?</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.ListaCanais != null && Model.ListaCanais.Count > 0 && Model.ListaCanais[0].Sucesso)
                {
                    foreach (var item in Model.ListaCanais)
                    {
                        <tr>
                            <td style="text-align: center"><svg fill="#899bbd" width="24px" height="24px" viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="M8 2L8 6L4 6L4 48L46 48L46 14L30 14L30 6L26 6L26 2 Z M 10 4L24 4L24 8L28 8L28 46L19 46L19 39L15 39L15 46L6 46L6 8L10 8 Z M 10 10L10 12L12 12L12 10 Z M 14 10L14 12L16 12L16 10 Z M 18 10L18 12L20 12L20 10 Z M 22 10L22 12L24 12L24 10 Z M 10 15L10 19L12 19L12 15 Z M 14 15L14 19L16 19L16 15 Z M 18 15L18 19L20 19L20 15 Z M 22 15L22 19L24 19L24 15 Z M 30 16L44 16L44 46L30 46 Z M 32 18L32 20L34 20L34 18 Z M 36 18L36 20L38 20L38 18 Z M 40 18L40 20L42 20L42 18 Z M 10 21L10 25L12 25L12 21 Z M 14 21L14 25L16 25L16 21 Z M 18 21L18 25L20 25L20 21 Z M 22 21L22 25L24 25L24 21 Z M 32 22L32 24L34 24L34 22 Z M 36 22L36 24L38 24L38 22 Z M 40 22L40 24L42 24L42 22 Z M 32 26L32 28L34 28L34 26 Z M 36 26L36 28L38 28L38 26 Z M 40 26L40 28L42 28L42 26 Z M 10 27L10 31L12 31L12 27 Z M 14 27L14 31L16 31L16 27 Z M 18 27L18 31L20 31L20 27 Z M 22 27L22 31L24 31L24 27 Z M 32 30L32 32L34 32L34 30 Z M 36 30L36 32L38 32L38 30 Z M 40 30L40 32L42 32L42 30 Z M 10 33L10 37L12 37L12 33 Z M 14 33L14 37L16 37L16 33 Z M 18 33L18 37L20 37L20 33 Z M 22 33L22 37L24 37L24 33 Z M 32 34L32 36L34 36L34 34 Z M 36 34L36 36L38 36L38 34 Z M 40 34L40 36L42 36L42 34 Z M 32 38L32 40L34 40L34 38 Z M 36 38L36 40L38 40L38 38 Z M 40 38L40 40L42 40L42 38 Z M 10 39L10 44L12 44L12 39 Z M 22 39L22 44L24 44L24 39 Z M 32 42L32 44L34 44L34 42 Z M 36 42L36 44L38 44L38 42 Z M 40 42L40 44L42 44L42 42Z"></path></g></svg></td>
                            <td>@item.RazaoSocial</td>
                            <td>@item.NomeFantasia</td>
                            <td>@item.CNPJ</td>
                            <td>@($"{item.Cidade}/{item.Estado}")</td>
                            @if (item.Ativo)
                            {
                                <td><span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Ativo</span></td>
                            }
                            else
                            {
                                <td><span class="badge bg-danger"><i class="bi bi-exclamation-octagon me-1"></i> Inativo</span></td>
                            }
                            <td>
                                <a asp-action="Gerenciar" asp-controller="Canal" asp-route-id="@item.Id" class="btn btn-info btn-sm">Gerenciar</a>
                            </td>
                        </tr>
                        @foreach(var pa in item.PontosAtendimento)
                        {
                            if (pa != null)
                            {
                                <tr>
                                    <td style="text-align: right">? <svg width="24px" height="24px" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M1 6V15H6V11C6 9.89543 6.89543 9 8 9C9.10457 9 10 9.89543 10 11V15H15V6L8 0L1 6Z" fill="#899bbd"></path> </g></svg></td>
                                    <td>@pa.RazaoSocial</td>
                                    <td>@pa.NomeFantasia</td>
                                    <td>@pa.CNPJ</td>
                                    <td>@($"{pa.Cidade}/{pa.Estado}")</td>
                                    @if (pa.Ativo)
                                    {
                                        <td><span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Ativo</span></td>
                                    }
                                    else
                                    {
                                        <td><span class="badge bg-danger"><i class="bi bi-exclamation-octagon me-1"></i> Inativo</span></td>
                                    }
                                    <td>
                                        <a asp-action="Gerenciar" asp-controller="PontoAtencimento" asp-route-id="@pa.Id" class="btn btn-info btn-sm">Gerenciar</a>
                                    </td>
                                </tr>
                            }
                        }
                    }
                }
            </tbody>

        </table>
    </div>

    <div style="overflow-x:auto;">
        <nav aria-label="Page navigation">
            <ul class="pagination">
                @if (Model.PaginaAtual > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index"
                           asp-route-pagina="@(Model.PaginaAtual - 1)"
                           asp-route-pesquisaAtivoInativo="@Model.PesquisaAtivoInativo"
                           asp-route-pesquisaRazaoSocial="@Model.PesquisaRazaoSocial">Anterior</a>
                    </li>
                }

                @for (var i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaAtual ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-pagina="@i"
                           asp-route-pesquisaAtivoInativo="@Model.PesquisaAtivoInativo"
                           asp-route-pesquisaRazaoSocial="@Model.PesquisaRazaoSocial">@i</a>
                    </li>
                }

                @if (Model.PaginaAtual < Model.TotalPaginas)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index"
                           asp-route-pagina="@(Model.PaginaAtual + 1)"
                           asp-route-pesquisaAtivoInativo="@Model.PesquisaAtivoInativo"
                           asp-route-pesquisaRazaoSocial="@Model.PesquisaRazaoSocial">Próximo</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
