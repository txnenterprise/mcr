@model MCR.API.Models.ViewModels.UsuarioModel
@{
    ViewData["Title"] = "Usuários - Desbloquear";
}
<div class="form-box">
    <h4 class="form-title form-box-title justify-content-center align-items-center">Usuários - Desbloquear</h4>
    <br /><br />
    <div class="row">
        <div class="col-md-2">
            <a asp-action="Index" asp-controller="Usuario" class="btn btn-secondary rounded-pill">
                Voltar
            </a>
        </div>
    </div>
    <br /><br />
    <form asp-controller="Usuario" asp-action="ConfirmarDesbloqueio" method="post" id="formCadastro">
        <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)">
            <div class="card-body" style="color: var(--color-primary)">
                <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)">
                    <div class="card-body" style="color: var(--color-primary)">
                        <div class="row">
                            <div class="col-sm-12 col-md-12 col-lg-12">
                                <h4>@Model.Nome</h4>
                                <ul class="list-group">
                                    <li class="list-group-item">@Model.Email</li>
                                    <li class="list-group-item">@Model.PerfilAcesso</li>
                                </ul>
                            </div>
                            <br />
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-sm-12 col-md-3 col-lg-3">
                                <div class="social-login">
                                    <button type="submit" class="login-btn btn d-flex justify-content-center align-items-center">Confirmar Desbloqueio</button>
                                </div>
                                <input type="hidden" asp-for="Id" />
                                <input type="hidden" asp-for="Email" />
                            </div>
                            <br />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <br />
        <div class="social-login">
            <button type="submit" class="btn btn-success rounded-pill">
                Salvar
            </button>
        </div>
    </form>
    @if (Model != null && !Model.Sucesso)
    {
        <br />
        <div class="alert alert-warning text-center" role="alert" style="color: #b59900; border-radius: 15px">
            <h6>Atenção!</h6>
            <h6>@Model.Mensagem</h6>
        </div>
    }
</div>