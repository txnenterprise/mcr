@model MCR.API.Usuario.Domain.DTO.UsuarioAlterarDTO
<form id="formCadastro"
      asp-antiforgery="true"
      asp-action="Alterar"
      asp-controller="Usuario"
      data-ajax="true" data-ajax-method="POST"
      data-ajax-success="userJs.OnSuccessCallback"
      data-ajax-failure="gl.onFailed"
      data-ajax-begin="gl.BeginAjax"
      data-ajax-complete="gl.CompleteAjax">
    <input type="hidden" asp-for="Id">

    <div class="card pt-3" style="border-radius: 15px; border-color: var(--color-primary)">
        <div class="card-body" style="color: var(--color-primary)">
            <div class="row">
                <div class="col-sm-12 col-md-6 col-lg-4 mb-3">
                    <div class="form-floating">
                        @if ((bool?)ViewBag.NotChangeProfile == true)
                        {
                            <p class="form-control form-input form-control-placeholder">@Model.PerfilAcesso</p>
                            <input type="hidden"  asp-for="PerfilAcesso" />
                        }
                        else
                        {
                            <select class="form-select form-input form-control-placeholder" aria-label="PerfilAcesso" asp-for="PerfilAcesso" id="PerfilAcesso" asp-items="ViewBag.ListaPerfis">
                                <option value="">Selecione um perfil</option>
                            </select>
                        }
                        <label for="PerfilAcesso">Perfil de Acesso</label>
                        <span asp-validation-for="PerfilAcesso" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-sm-12 col-md-6 col-lg-4 mb-3">
                    <div class="form-floating">
                        <input type="text" class="form-control form-input form-control-placeholder" asp-for="Nome" id="Nome" placeholder="Nome" required>
                        <label for="Nome">Nome</label>
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-sm-12 col-md-6 col-lg-4 mb-3">
                    <div class="form-floating">
                        <input type="email" class="form-control form-input form-control-placeholder" asp-for="Email" id="Email" placeholder="E-Mail" required>
                        <label for="Email">E-Mail</label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-sm-12 col-md-6 col-lg-4 mb-3">
                    <div class="form-floating">
                        <input type="text" class="form-control form-input form-control-placeholder" asp-for="Document" id="Document" placeholder="Documento">
                        <label for="Document">Documento</label>
                        <span asp-validation-for="Document" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-sm-12 col-md-6 col-lg-4 mb-3">
                    <div class="form-floating">
                        <input type="text" class="form-control form-input form-control-placeholder" asp-for="PhoneNumber" id="PhoneNumber" placeholder="Telefone">
                        <label for="PhoneNumber">Telefone</label>
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-sm-12 col-md-6 col-lg-4 mb-3">
                    <div class="form-check form-switch mt-4">
                        <input class="form-check-input" type="checkbox" role="switch" asp-for="UtilizaOAuth" id="UtilizaOAuth">
                        <label class="form-check-label" for="UtilizaOAuth">Utilizará oAuth?</label>
                    </div>
                </div>
                <div class="social-login">
                <button type="button" class="btn btn-primary me-2" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                    Alterar Senha
                </button>
                </div>
            </div>

            <div class="row mt-2">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5>Estrutura de Negócios</h5>
                </div>
                <div class="col-sm-12 col-md-3 col-lg-3">
                    <div class="form-floating">
                        @{
                            var corretoraDisabled = (ViewBag.CorretoraCount == 1 ? "disabled" : null);
                        }
                        <select class="form-select selected2" asp-items="@ViewBag.Corretora" asp-for="DefaultCorretoraId" disabled="@corretoraDisabled">
                            <option value="">Selecione...</option>
                        </select>
                        <label for="DefaultCorretoraId">Corretora</label>
                    </div>
                </div>
                <div class="col-sm-12 col-md-4 col-lg-4">
                    <div class="form-floating">
                        @{
                            var canalDisabled = (ViewBag.CanalCount == 1 ? "disabled" : null);
                        }
                        <select class="form-select selected2" asp-items="@ViewBag.Canal" asp-for="DefaultCanalId" disabled="@canalDisabled">
                            <option value="">Selecione...</option>
                        </select>

                        <label for="DefaultCanalId">Canal</label>
                    </div>
                </div>
                <div class="col-sm-12 col-md-4 col-lg-4">
                    <div class="form-floating">
                        @{
                            var paDisabled = (ViewBag.PACount == 1 ? "disabled" : null);
                        }
                        <select class="form-select selected2" asp-items="@ViewBag.PontoAtendimento" asp-for="DefaultPontoAtendimentoId" disabled="@paDisabled">
                            <option value="">Selecione...</option>
                        </select>
                        <label for="DefaultPontoAtendimentoId">Ponto Atendimento</label>
                    </div>
                </div>
                <div class="col-sm-12 col-md-1 col-lg-1 pt-2">
                    <button type="button" id="btnAddEN" class="btn btn-primary">Adicionar</button>
                </div>

                <div class="col-sm-12 col-md-12 col-lg-12 pt-5">
                    <table class="table table-striped table-bordered" style="width:100%">
                        <thead>
                            <tr>
                                <th style="width:30%;">Corretora</th>
                                <th style="width:30%;">Canal</th>
                                <th style="width:30%;">Ponto Atendimento</th>
                                <th class="text-center">Ação</th>
                            </tr>
                        </thead>
                        <tbody id="table_body">
                            
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <br />
    <div class="social-login">
        
        <button type="submit" class="btn btn-success">
            Salvar
        </button>
    </div>
</form>

<!-- Modal de Alteração de Senha -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="changePasswordModalLabel">Alterar Senha</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="changePasswordForm">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="newPassword" class="form-label">Nova Senha</label>
                        <input type="password" class="form-control" id="newPassword" required>
                    </div>
                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label">Confirmar Nova Senha</label>
                        <input type="password" class="form-control" id="confirmPassword" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnChangePassword">Alterar Senha</button>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="enHistory" value="@System.Text.Json.JsonSerializer.Serialize(Model.EstruturaNegocio)" />