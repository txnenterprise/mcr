@model List<MCR.API.Propostas.Domain.DTO.PropostasStatusDTO>
@{
    Layout = null;
}

<div class="row mb-3">
    <div class="col">
        <h5>Histórico dos Status da Proposta</h5>
    </div>
    <div class="col text-end">
        <button type="button"
                proposal-status-permission="@ViewBag.PropostaStatus"
                proposal-status-button="true"
                data-proposta="@ViewBag.PropostaId"
                class="btn btn-primary btn-sm btStatus">
            Alterar Status
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">
                Nenhum status encontrado para esta proposta.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Data</th>
                            <th>Detalhes</th>
                            <th>@*Ações*@</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var status in Model)
                        {
                            <tr>
                                <td>
                                    @status.Status
                                    @if (status.Status == "Pendente")
                                    {
                                        <span class="badge bg-warning text-dark ms-1">Pendente</span>
                                    }
                                    else if (status.Status == "Proposta aceita")
                                    {
                                        <span class="badge bg-success ms-1">Aceita</span>
                                    }
                                    else if (status.Status == "Proposta recusada" || status.Status == "Proposta cancelada" || status.Status == "Cotação encerrada sem sucesso" || status.Status == "Apólice cancelada")
                                    {
                                        <span class="badge bg-danger ms-1">Encerrada</span>
                                    }
                                    else if (status.Status == "Proposta com pendência")
                                    {
                                        <span class="badge bg-warning text-dark ms-1">Pendência</span>
                                    }
                                    else if (status.Status == "Apólice emitida")
                                    {
                                        <span class="badge bg-primary ms-1">Apólice</span>
                                    }
                                </td>
                                <td>@status.DataStatus?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td>

                                    @if (status.JustificativaDTO != null)
                                    {
                                        <div><strong>Justificativa:</strong> @status.JustificativaDTO.Justificativa</div>
                                    }

                                    @if (status.PendenciaDTO != null)
                                    {
                                        <div><strong>Tipo de Documento:</strong> @status.PendenciaDTO.TipoDocumento</div>
                                        <div><strong>Retorno:</strong> @status.PendenciaDTO.RetornoPendencia</div>
                                        @if (!string.IsNullOrEmpty(status.PendenciaDTO.UploadArquivo))
                                        {
                                            <div>
                                                <a href="@status.PendenciaDTO.UploadArquivo" target="_blank" class="btn btn-sm btn-outline-primary mt-1">
                                                    <i class="fas fa-file me-1"></i> Ver Documento
                                                </a>
                                            </div>
                                        }
                                    }

                                    @if (status.AceitaDTO != null)
                                    {
                                        <div><strong>Número da Proposta:</strong> @status.AceitaDTO.NumeroProposta</div>
                                        <div><strong>LMI Total:</strong> @status.AceitaDTO.LmiTotal</div>
                                        <div><strong>Prêmio Total:</strong> @status.AceitaDTO.PremioTotal</div>
                                        <div><strong>Parcela do Segurado:</strong> @status.AceitaDTO.ParcelaSegurado.ToString("N2")</div>
                                        <div><strong>Vencimento:</strong> @(status.AceitaDTO.DataVencimento?.ToString("dd/MM/yyyy") ?? "Boleto não emitido")</div>
                                        <div class="mt-1">
                                            @if (!string.IsNullOrEmpty(status.AceitaDTO.PropostaSeguradora))
                                            {
                                                <a href="@status.AceitaDTO.PropostaSeguradora" target="_blank" class="btn btn-sm btn-outline-success me-2">
                                                    <i class="fas fa-file-pdf me-1"></i> Proposta
                                                </a>
                                            }
                                            @if (!string.IsNullOrEmpty(status.AceitaDTO.Boleto))
                                            {
                                                <a href="@status.AceitaDTO.Boleto" target="_blank" class="btn btn-sm btn-outline-warning">
                                                    <i class="fas fa-file-invoice-dollar me-1"></i> Boleto
                                                </a>
                                            }
                                        </div>
                                    }

                                    @if (status.ApoliceEmitidaDTO != null)
                                    {
                                        <div><strong>Número da Apólice:</strong> @status.ApoliceEmitidaDTO.NumeroApolice</div>
                                        <div><strong>Vigência:</strong> @status.ApoliceEmitidaDTO.InicioVigencia.ToString("dd/MM/yyyy") a @status.ApoliceEmitidaDTO.FinalVigencia.ToString("dd/MM/yyyy")</div>
                                        <div><strong>Vencimento:</strong> @status.ApoliceEmitidaDTO.DataVencimento?.ToString("dd/MM/yyyy")</div>
                                        <div class="mt-1">
                                            @if (!string.IsNullOrEmpty(status.ApoliceEmitidaDTO.ApoliceEmitida))
                                            {
                                                <a href="@status.ApoliceEmitidaDTO.ApoliceEmitida" target="_blank" class="btn btn-sm btn-outline-primary me-2">
                                                    <i class="fas fa-file-contract me-1"></i> Apólice
                                                </a>
                                            }
                                            @if (!string.IsNullOrEmpty(status.ApoliceEmitidaDTO.Boleto))
                                            {
                                                <a href="@status.ApoliceEmitidaDTO.Boleto" target="_blank" class="btn btn-sm btn-outline-warning">
                                                    <i class="fas fa-file-invoice-dollar me-1"></i> Boleto
                                                </a>
                                            }
                                        </div>
                                    }
                                </td>
                                @*<td>
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                                Ações
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <a class="dropdown-item"
                                                       href="@Url.Action("DetalhesStatus", "Propostas", new { statusId = status.Id })">
                                                        <i class="fas fa-eye me-1"></i> Detalhes
                                                    </a>
                                                </li>
                                                @if (status.Id != null)
                                                {
                                                    <li>
                                                        <a class="dropdown-item"
                                                           href="@Url.Action("ImprimirStatus", "Propostas", new { statusId = status.Id })">
                                                            <i class="fas fa-print me-1"></i> Imprimir
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </td>*@
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
