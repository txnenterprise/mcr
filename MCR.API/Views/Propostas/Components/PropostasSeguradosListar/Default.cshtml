
@model List<MCR.API.Propostas.Domain.DTO.PropostasSeguradosDTO>

<!-- Cliente Principal -->
<div id="clientePrincipal" class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="mb-0 fw-bold">Cliente</h6>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead class="table-light">
                <tr>
                    <th>Nome</th>
                    <th>CPF</th>
                    <th>Telefone</th>
                    <th>E-mail</th>
                    <th>Relação</th>
                    <th class="text-center">Ação</th>
                </tr>
            </thead>
            <tbody id="tbodyClientePrincipal">
                @foreach (var item in Model.Where(x => !x.VinculoFamiliarId.HasValue).ToList())
                {
                    <tr>
                        <td>@item.Nome</td>
                        <td>@item.CPF.FormatCpfCnpj()</td>
                        <td>@item.Telefone.FormatCelular()</td>
                        <td>@item.Email</td>
                        <td>@item.RelacaoParental</td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-primary btnSegurado" data-proposta="@item.PropostaId" data-cliente="@item.ClienteId" data-vinculo="@item.VinculoFamiliarId">Selecionar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Familiares (se existirem) -->
<div id="clienteFamiliares" class="mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="mb-0 fw-bold">Integrantes do Grupo Familiar</h6>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead class="table-light">
                <tr>
                    <th>Nome</th>
                    <th>CPF</th>
                    <th>Telefone</th>
                    <th>E-mail</th>
                    <th>Relação</th>
                    <th class="text-center">Ação</th>
                </tr>
            </thead>
            <tbody id="tbodyClienteFamiliares">
                @foreach (var item in Model.Where(x => x.VinculoFamiliarId.HasValue).ToList())
                {
                    <tr>
                        <td>@item.Nome</td>
                        <td>@item.CPF.FormatCpfCnpj()</td>
                        <td>@item.Telefone.FormatCelular()</td>
                        <td>@item.Email</td>
                        <td>@item.RelacaoParental</td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-primary btnSegurado" data-proposta="@item.PropostaId" data-cliente="@item.ClienteId" data-vinculo="@item.VinculoFamiliarId">Selecionar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
